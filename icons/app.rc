1 ICON "app.ico"

// The name Windows shows for the exe (Task Manager, the file's Properties).
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Banjo Re-Tooie"
            VALUE "ProductName", "Banjo Re-Tooie"
            VALUE "InternalName", "BanjoReTooie"
            VALUE "OriginalFilename", "BanjoReTooie.exe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
