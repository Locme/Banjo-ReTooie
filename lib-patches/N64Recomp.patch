+#if RECOMP_SSE_ROUNDING
+// Banjo-Tooie: on x86-64 floats are done in SSE, so the rounding mode the game sets around its float to int
+// conversions (cfc1/ctc1) is MXCSR's, bits 13-14. fegetround and fesetround also read and set the x87 unit, and with
+// MSVC's runtime they were most of the game thread's own CPU time in a profile of every map (tools/perf_sweep.py).
+static inline uint32_t get_cop1_cs() {
+    // MXCSR's 00 nearest, 01 down, 10 up, 11 toward zero; the N64's 0 nearest, 1 toward zero, 2 up, 3 down.
+    static const uint32_t from_sse[4] = { 0, 3, 2, 1 };
+    return from_sse[(_mm_getcsr() >> 13) & 3];
+}
+
+static inline void set_cop1_cs(uint32_t val) {
+    static const uint32_t to_sse[4] = { 0, 3, 2, 1 };
+    const uint32_t csr = _mm_getcsr();
+    const uint32_t want = (csr & ~(3u << 13)) | (to_sse[val & 3] << 13);
+    if (want != csr) {
+        _mm_setcsr(want);
+    }
+}
+#else
 static inline uint32_t get_cop1_cs() {
     uint32_t rounding_mode = 0;
     switch (fegetround()) {
@@ -304,6 +328,7 @@ static inline void set_cop1_cs(uint32_t val) {
     }
     fesetround(round);
 }
+#endif
 
