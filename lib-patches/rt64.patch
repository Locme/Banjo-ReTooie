     }
     
+    // Banjo-Tooie: a 3D grass blade grown from green ground is shaded from its root to its tip; a 3D grass shell
+    // keeps only the blades crossing it, on green ground facing up.
+    if ((gConstants.grassShell != 0) && ((gConstants.grassShells & RASTER_GRASS_BLADES) != 0)) {
