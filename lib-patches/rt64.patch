+#define RASTER_SNOW_TESS 0x04000000u
+    // Banjo-Tooie: with RASTER_SNOW_TESS, the pass that draws the ground itself where it is, in place of its own draw,
+    // with holes where the trail goes down below it (through Icy Side's own snow layer); the raised snow is drawn after
+    // it, so the ground shows through wherever the raised surface leaves a crack.
+#define RASTER_SNOW_GROUND 0x02000000u
+#define RASTER_SHELL_COUNT_MASK 0xFFFFu
+    // Banjo-Tooie: set in furShells for a furry enemy's white fur (the yeti) instead of Banjo's brown; the low bits are
+    // the shell count.
+#define RASTER_FUR_WHITE 0x10000u
+    // Banjo-Tooie: the bits of RasterParams.nightLight.
+#define RASTER_NIGHT_LIGHT 0x1u
+#define RASTER_PARALLAX 0x2u
+#define RASTER_PARALLAX_HEIGHT_MAP 0x1000000u
+// Banjo-Tooie: a texture's parallax shape in bits 25 to 27 with its bit 3 in RASTER_PARALLAX_SHAPE_HIGH (0 stone,
+// 1 bumpy, 2 inverted, 3 cracks, 4 terraced, 5 rounded, 6 grass, 7 wood, 8 bark, 9 brick, 10 dirt, 11 metal, 12 leaves,
+// 13 tiles, 14 sand, 15 smooth), its depth in 28 to 30 (0 100%, 1 25%, 2 50%, 3 150%, 4 200%, 5 300%) and no shadows in 31.
+#define RASTER_PARALLAX_NO_SHADOWS 0x80000000u
+#define RASTER_PARALLAX_SHAPE_HIGH 0x4u
+// Banjo-Tooie: a texture's depth in 10% steps (1 to 31), instead of the depth bits, when not 0.
+#define RASTER_PARALLAX_FINE_DEPTH 0xF8u
+#define RASTER_PARALLAX_FINE_DEPTH_SHIFT 3
+    // Banjo-Tooie: no piece beside the draw on that side (RasterParams.seamTiles).
+#define RASTER_SEAM_NONE 0xFFFFFFFFu
+
     struct RasterParams {
         uint renderIndex;
-        uint3 padding;
+        // Banjo-Tooie: 1 while redrawing water into the scene effects' water mask (the draw outputs its depth), 2
+        // into Modern water's colours (its own colour and blending alpha).
+        uint waterMask;
+        // Banjo-Tooie: 3D grass: which shell of the blades this redraw is (1 to grassShells; 0 the ground itself),
+        // or with RASTER_GRASS_BLADES which pass of blades.
+        uint grassShell;
+        uint grassShells;
         float2 screenScale;
         float2 screenOffset;
+        // Banjo-Tooie: Banjo's fur: which shell this redraw is (1 to furShells; 0 the model itself).
+        uint furShell;
+        uint furShells;
+        // Banjo-Tooie: RASTER_NIGHT_LIGHT when the draw's texture is a window or lamp that lights up at night
+        // (FrameParams.nightLights), RASTER_PARALLAX when it is stone with parallax mapping (Parallax.hlsli), with its
+        // texture's darkest brightness in bits 8 to 15 and its lightest in 16 to 23, or RASTER_PARALLAX_HEIGHT_MAP when
+        // a texture pack gives its height (GPUTile.heightIndex).
+        uint nightLight;
+        uint seamPadding;
+        // Banjo-Tooie: Blend texture seams: the tiles (global indices) of the pieces of the same picture drawn right of,
+        // below, left of and above this one, which its texture blends into at its edges (TextureSampler.hlsli), or
+        // RASTER_SEAM_NONE; the top bit set on pieces of the 3D world.
+        uint4 seamTiles;
     };
