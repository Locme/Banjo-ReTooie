+    // Banjo-Tooie: hands deep snow the triangles of a model's draw near Banjo, in the world (SceneSnowTouch), so the
+    // snow is pressed down wherever they reach into it.
+    static void snowTouchDraw(const DrawData &drawData, const GameCall &call, const interop::FrameParams &frameParams) {
