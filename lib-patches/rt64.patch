+    // they fade a little into the grass round them, which still reads as road.
+    static constexpr float GrassMaskAlpha = 0.2f;
+
+    // Banjo-Tooie: the coarser grid of where the frame's grass ground lies (same corner as grassMask, 4 of its cells
