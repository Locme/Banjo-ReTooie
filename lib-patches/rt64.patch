+    // Banjo-Tooie: a lamp's light, merged into one already found close by (a lantern's panes may be drawn apart).
+    // reach: 900 for a lamp; a Light Source pick (rt64_texture_marks.h) its own as a whole number, with the object's
+    // size in the fraction (SceneLightSourceW), so the shader lights from the object's surface, not a point inside it.
+    static void addLampLight(std::vector<float> &lights, hlslpp::float3 centre, float reach = 900.0f) {
+        for (size_t i = 0; i + 3 < lights.size(); i += 4) {
+            const hlslpp::float3 other(lights[i], lights[i + 1], lights[i + 2]);
+            if (float(hlslpp::length(other - centre)) < 80.0f) {
+                return;
+            }
+        }
+        if (lights.size() >= SceneMaxLights * 4) {
+            return;
+        }
+        lights.insert(lights.end(), { float(centre.x), float(centre.y), float(centre.z), reach });
+    }
