+    const float3 px = LoadAnyWater(pixel + int2(1, 0), dr) ? ViewPosition(pixel + int2(1, 0), dr) - c : (LoadAnyWater(pixel - int2(1, 0), dl) ? c - ViewPosition(pixel - int2(1, 0), dl) : float3(1.0f, 0.0f, 0.0f));
