+        // then the world, on the same picture (the Spiral Mountain pool). The effects go once, after the last
+        // part, with the water of every part in their mask; they ran after each part, so the sky got them twice.
+        if (worldEnd > 0) {
+            for (uint32_t i = 0; (i + 1) < framebufferCount; i++) {
+                RenderTargetDrawCall &earlier = framebufferVector[i].renderTargetDrawCall;
+                if ((earlier.sceneEffectsAfter > 0) && (earlier.sceneEffectsDrawData == targetDrawCall.sceneEffectsDrawData) &&
+                    (earlier.fbStorage->colorTarget == targetDrawCall.fbStorage->colorTarget))
+                {
+                    targetDrawCall.waterInstances.insert(targetDrawCall.waterInstances.begin(), earlier.waterInstances.begin(), earlier.waterInstances.end());
+                    targetDrawCall.waterLeftOutClosed += earlier.waterLeftOutClosed;
+                    targetDrawCall.waterLeftOutSmall += earlier.waterLeftOutSmall;
+                    earlier.waterHandedOn = std::move(earlier.waterInstances);
+                    earlier.waterInstances.clear();
+                    earlier.sceneEffectsAfter = -1;
+                }
+            }
+        }
     }
 
