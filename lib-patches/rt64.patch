+    // Banjo-Tooie: where a draw sits in the world, the middle of its vertices (a lamp's light, AddLampLight), and with
+    // radius how far its furthest vertex is from there.
+    static bool drawCentre(const DrawData &drawData, const GameCall &call, hlslpp::float3 &centre, float *radius = nullptr) {
+        const uint32_t start = call.meshDesc.faceIndicesStart;
+        const uint32_t end = start + call.callDesc.triangleCount * 3;
+        if ((end > drawData.faceIndices.size()) || (end == start)) {
+            return false;
+        }
+        hlslpp::float3 sum(0.0f, 0.0f, 0.0f);
+        for (uint32_t i = start; i < end; i++) {
+            const uint32_t v = drawData.faceIndices[i];
+            if (((v * 3 + 2) >= drawData.posFloats.size()) || (v >= drawData.worldIndices.size()) || (drawData.worldIndices[v] >= drawData.worldTransforms.size())) {
+                return false;
+            }
+            const float (&m)[4][4] = drawData.worldTransforms[drawData.worldIndices[v]].m;
+            const float x = drawData.posFloats[v * 3 + 0], y = drawData.posFloats[v * 3 + 1], z = drawData.posFloats[v * 3 + 2];
+            sum += hlslpp::float3(x * m[0][0] + y * m[1][0] + z * m[2][0] + m[3][0], x * m[0][1] + y * m[1][1] + z * m[2][1] + m[3][1],
+                x * m[0][2] + y * m[1][2] + z * m[2][2] + m[3][2]);
+        }
+        centre = sum / float(end - start);
+        if (radius != nullptr) {
+            float most = 0.0f;
+            for (uint32_t i = start; i < end; i++) {
+                const uint32_t v = drawData.faceIndices[i];
+                const float (&m)[4][4] = drawData.worldTransforms[drawData.worldIndices[v]].m;
+                const float x = drawData.posFloats[v * 3 + 0], y = drawData.posFloats[v * 3 + 1], z = drawData.posFloats[v * 3 + 2];
+                const hlslpp::float3 p(x * m[0][0] + y * m[1][0] + z * m[2][0] + m[3][0], x * m[0][1] + y * m[1][1] + z * m[2][1] + m[3][1],
+                    x * m[0][2] + y * m[1][2] + z * m[2][2] + m[3][2]);
+                most = std::max(most, float(hlslpp::length(p - centre)));
+            }
+            *radius = most;
+        }
+        return true;
+    }
