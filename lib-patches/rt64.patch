+        const char *forced = std::getenv("TOOIE_RAY_TRACING_SUPPORT");
+        if ((forced != nullptr) && (forced[0] == '0')) {
+            supported = false;
+        }
+        const std::scoped_lock lock(effectsMutex);
+        rayTracingSupport.store(supported ? 2 : 1);
+        RefreshReflections();
+    }
