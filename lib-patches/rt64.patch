+                        out[x * 4 + 0] = texel[2];
+                        out[x * 4 + 1] = texel[1];
+                        out[x * 4 + 2] = texel[0];
+                    }
+                    else {
+                        out[x * 4 + 0] = texel[0];
+                        out[x * 4 + 1] = texel[1];
+                        out[x * 4 + 2] = texel[2];
+                    }
+
+                    out[x * 4 + 3] = 0xFF;
+                }
+            }
+
+            readback.buffer->unmap();
+            readback.callback(readback.width, readback.height, std::move(rgba));
+        }
