+        const float y0 = -(v[0][1] * v[2][2] - v[0][2] * v[2][1]) / det;
+        const float y1 = (v[0][0] * v[2][2] - v[0][2] * v[2][0]) / det;
+        const float y2 = -(v[0][0] * v[2][1] - v[0][1] * v[2][0]) / det;
+        sceneCameraHeight = -(v[3][0] * y0 + v[3][1] * y1 + v[3][2] * y2);
+        sceneCameraKnown = true;
+    }
