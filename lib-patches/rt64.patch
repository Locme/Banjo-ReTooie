+    void FramebufferRenderer::submitGrassHiZ(RenderWorker *worker, RenderTarget *depthTarget) {
+        GrassInstancing &g = grassInstancing;
+        const bool multisampled = (depthTarget != nullptr) && (depthTarget->multisampling.sampleCount > 1);
+        RenderPipeline *finePipeline = multisampled ? shaderLibrary->grassHiZMS.get() : shaderLibrary->grassHiZ.pipeline.get();
+        if ((depthTarget == nullptr) || (depthTarget->texture == nullptr) || (finePipeline == nullptr) || (shaderLibrary->grassHiZCoarse == nullptr) ||
+            ((SceneGrassCulling() & GRASS_CULL_OCCLUSION) == 0) || (g.hizFine == nullptr))
+        {
+            return;
+        }
+
+        const uint32_t width = depthTarget->width, height = depthTarget->height;
+        const uint32_t fineWidth = (width + GRASS_HIZ_FINE - 1) / GRASS_HIZ_FINE, fineHeight = (height + GRASS_HIZ_FINE - 1) / GRASS_HIZ_FINE;
+        const uint32_t coarseWidth = (fineWidth + GRASS_HIZ_COARSE - 1) / GRASS_HIZ_COARSE, coarseHeight = (fineHeight + GRASS_HIZ_COARSE - 1) / GRASS_HIZ_COARSE;
+        if ((width == 0) || (height == 0)) {
+            return;
+        }
+
+        if ((g.hizFineSize[0] != fineWidth) || (g.hizFineSize[1] != fineHeight)) {
+            // (The frame's culling pass already read the old ones: they go once the frame is done.)
+            g.retiredTextures.push_back(std::move(g.hizFine));
+            g.retiredTextures.push_back(std::move(g.hizCoarse));
+            g.hizFine = worker->device->createTexture(RenderTextureDesc::Texture2D(fineWidth, fineHeight, 1, RenderFormat::R32_FLOAT, RenderTextureFlag::STORAGE | RenderTextureFlag::UNORDERED_ACCESS));
+            g.hizFine->setName("Grass Depth Pyramid Fine");
+            g.hizCoarse = worker->device->createTexture(RenderTextureDesc::Texture2D(coarseWidth, coarseHeight, 1, RenderFormat::R32_FLOAT, RenderTextureFlag::STORAGE | RenderTextureFlag::UNORDERED_ACCESS));
+            g.hizCoarse->setName("Grass Depth Pyramid Coarse");
+            g.hizFineSize[0] = fineWidth;
+            g.hizFineSize[1] = fineHeight;
+            g.hizCoarseSize[0] = coarseWidth;
+            g.hizCoarseSize[1] = coarseHeight;
+            g.hizSource = nullptr;
+        }
+
+        if (g.hizFineSet == nullptr) {
+            g.hizFineSet = std::make_unique<GrassHiZDescriptorSet>(worker->device);
+            g.hizCoarseSet = std::make_unique<GrassHiZDescriptorSet>(worker->device);
+        }
+
+        g.hizFineSet->setTexture(g.hizFineSet->gSource, depthTarget->texture.get(), RenderTextureLayout::SHADER_READ, depthTarget->textureView.get());
+        g.hizFineSet->setTexture(g.hizFineSet->gTarget, g.hizFine.get(), RenderTextureLayout::GENERAL);
+        g.hizCoarseSet->setTexture(g.hizCoarseSet->gSource, g.hizFine.get(), RenderTextureLayout::SHADER_READ);
+        g.hizCoarseSet->setTexture(g.hizCoarseSet->gTarget, g.hizCoarse.get(), RenderTextureLayout::GENERAL);
+
+        RenderCommandList *commandList = worker->commandList.get();
+        const RenderTextureBarrier before[] = {
+            RenderTextureBarrier(depthTarget->texture.get(), RenderTextureLayout::SHADER_READ),
+            RenderTextureBarrier(g.hizFine.get(), RenderTextureLayout::GENERAL)
+        };
+        commandList->barriers(RenderBarrierStage::COMPUTE, before, uint32_t(std::size(before)));
+        commandList->setComputePipelineLayout(shaderLibrary->grassHiZ.pipelineLayout.get());
+        interop::GrassHiZCB cb;
+        cb.sourceSize = { width, height };
+        cb.targetSize = { fineWidth, fineHeight };
+        commandList->setComputePushConstants(0, &cb);
+        commandList->setComputeDescriptorSet(g.hizFineSet->get(), 0);
+        commandList->setPipeline(finePipeline);
+        commandList->dispatch((fineWidth + 7) / 8, (fineHeight + 7) / 8, 1);
+
+        const RenderTextureBarrier between[] = {
+            RenderTextureBarrier(g.hizFine.get(), RenderTextureLayout::SHADER_READ),
+            RenderTextureBarrier(g.hizCoarse.get(), RenderTextureLayout::GENERAL)
+        };
+        commandList->barriers(RenderBarrierStage::COMPUTE, between, uint32_t(std::size(between)));
+        cb.sourceSize = { fineWidth, fineHeight };
+        cb.targetSize = { coarseWidth, coarseHeight };
+        commandList->setComputePushConstants(0, &cb);
+        commandList->setComputeDescriptorSet(g.hizCoarseSet->get(), 0);
+        commandList->setPipeline(shaderLibrary->grassHiZCoarse.get());
+        commandList->dispatch((coarseWidth + 7) / 8, (coarseHeight + 7) / 8, 1);
+
+        commandList->barriers(RenderBarrierStage::COMPUTE, RenderTextureBarrier(g.hizCoarse.get(), RenderTextureLayout::SHADER_READ));
+        g.lastDepthSize[0] = width;
+        g.lastDepthSize[1] = height;
+        g.hizBuilt = true;
     }
 
