+    // Banjo-Tooie: deep snow's ground vertices for RasterVS (snowPositions): world x, y, z, then how much of the snow's
+    // height lies there, 0 on the edge of the snowy ground (where it meets a wall, the ice, or ground without snow) rising
+    // smoothly to 1 by ramp units in, so the raised snow meets the meshes round it without a step.
+    static void snowGroundVertices(const DrawData &drawData, const std::vector<std::pair<uint32_t, uint32_t>> &faceRanges, uint32_t first, uint32_t end,
+        float ramp, std::vector<float> &out)
+    {
+        out.resize(size_t(end) * 4);
+        auto at = [&](uint32_t v) { return hlslpp::float3(drawData.posFloats[v * 3 + 0], drawData.posFloats[v * 3 + 1], drawData.posFloats[v * 3 + 2]); };
