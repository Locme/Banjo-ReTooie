+        int scaleRow = 0;
+        if (!vpSplitOld()) {
+            for (int i = 1; i < 3; i++) {
+                if (abs(float(v[i][2])) > abs(float(v[scaleRow][2]))) {
+                    scaleRow = i;
+                }
+            }
+        }
+
+        p[2][2] = vp[scaleRow][2] / v[scaleRow][2];
         p[3][2] = vp[3][2] - p[2][2] * v[3][2];
 
         p[0][0] = sqrtf(sqr(vp[0][0]) + sqr(vp[1][0]) + sqr(vp[2][0]));
@@ -72,6 +103,32 @@ namespace RT64 {
             v = hlslpp::float4x4::identity();
             p = vp;
         }
+
+        // TEST: TOOIE_TEST_NEAR=<n> redraws with that near plane (same far), to test the effects with a short near.
+        static const float testNear = getenv("TOOIE_TEST_NEAR") ? float(atof(getenv("TOOIE_TEST_NEAR"))) : 0.0f;
+        if ((testNear > 0.0f) && (abs(float(p[2][2])) > 1.0001f) && (abs(float(p[2][2])) < 1.1f)) {
+            const float n = float(p[3][2]) / (float(p[2][2]) - 1.0f);
+            const float f = float(p[3][2]) / (float(p[2][2]) + 1.0f);
+            if ((n > testNear) && (f > n)) {
+                p[2][2] = (f + testNear) / (testNear - f);
+                p[3][2] = 2.0f * f * testNear / (testNear - f);
