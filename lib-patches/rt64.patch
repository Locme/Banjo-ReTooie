+        (1.0f - DayNight(tint)) * (1.0f - DayWeather().x);
+}
+
+// The mist and rain settings, from the sun shadows' constant (shadows.w = 4 * (strength (0 to 100) + 128 * when +
+// 512 * wet (0 to 31) + 16384 for raindrops) + 2 to leave Banjo out + softness): x the mist's strength (0 to 1),
+// y when (0 mornings, 1 mornings and nights, 2 always), z how wet the ground is (0 to 1), w 1 for raindrops on the
+// screen.
+float4 DayMistAndRain() {
+    float packed = floor(gConstants.shadows.w / 4.0f);
+    const float drops = (packed >= 16384.0f) ? 1.0f : 0.0f;
+    packed -= drops * 16384.0f;
+    const float wet = floor(packed / 512.0f);
+    packed -= wet * 512.0f;
+    const float when = floor(packed / 128.0f);
+    return float4((packed - when * 128.0f) / 100.0f, when, wet / 31.0f, drops);
+}
+
+float2 DayMistSetting() {
+    return DayMistAndRain().xy;
+}
+
+// Wet ground in and after the rain: everything darkens a little, and what faces up darkens more and turns
+// shiny, reflecting what is round it (a ray across the screen, as the water's reflections) with a sheen that
+// comes and goes over the ground. Not on Banjo himself, nor on the water.
+float3 DayWet(float3 scene, int2 pixel, float depth) {
+    const float wet = DayMistAndRain().z;
+    if ((wet <= 0.0f) || (depth >= 0.99999f) || (gConstants.fog.w > 0.0f)) {
+        return scene;
+    }
+    float waterDepth;
+    if ((gConstants.water.y > 0.5f) && LoadWater(pixel, waterDepth)) {
+        return scene;
+    }
+    const float3 center = ViewPosition(pixel, depth);
+    const float3 world = WorldPosition(center);
+    if (gConstants.rippleAge.w > -1e8f) {
+        const float across = length(world.xz - float2(gConstants.rippleX.w, gConstants.rippleZ.w));
+        const float up = world.y - gConstants.rippleAge.w;
+        if ((across < 45.0f) && (up > 3.0f) && (up < 140.0f)) {
+            return scene;
+        }
+    }
+    const float3 normal = ViewNormal(pixel, center);
+    const float level = saturate((dot(normal, normalize(gConstants.worldY.xyz)) - 0.55f) * 4.0f);
+    // Wet patches and drier ones, fixed to the ground.
+    const float patches = 0.55f + 0.45f * smoothstep(0.25f, 0.7f, WaterNoise(world.xz / 90.0f));
+    float3 result = scene * (1.0f - wet * (0.12f + 0.2f * level * patches));
+    const float shine = wet * level * patches;
+    if (shine > 0.02f) {
+        // A slightly rough surface: the normal wobbles with the position.
+        const float2 rough = float2(WaterNoise(world.xz / 7.0f), WaterNoise(world.zx / 7.0f + 13.0f)) - 0.5f;
+        const float3 n = normalize(normal + (normalize(gConstants.worldX.xyz) * rough.x + normalize(gConstants.worldZ.xyz) * rough.y) * 0.08f);
+        const float4 reflection = WaterReflection(center, n);
+        const float fresnel = 0.05f + 0.95f * pow(1.0f - saturate(dot(-normalize(center), n)), 5.0f);
+        result = lerp(result, reflection.rgb, saturate(shine * fresnel * reflection.a * 0.85f));
+    }
+    return result;
+}
+
+// Mist: pale banks drifting slowly over low ground (below and a little above Banjo's height), thicker with
+// distance, and thickest on and around water, where it hangs just over the surface even close by. Lit warm
+// towards the sun. Separate from the Fog setting.
+float3 DayMist(float3 color, int2 pixel, float depth, float3 tint) {
+    const float2 setting = DayMistSetting();
+    const float morning = DayMorning(tint);
+    const float night = DayNight(tint) * (1.0f - DayWeather().x * 0.5f);
+    const float when = (setting.y > 1.5f) ? 1.0f : ((setting.y > 0.5f) ? max(morning, night * 0.8f) : morning);
+    if ((setting.x <= 0.0f) || (when <= 0.0f) || (gConstants.rippleAge.w < -1e8f)) {
+        return color;
+    }
+    const float3 center = ViewPosition(pixel, depth);
+    const float3 world = WorldPosition(center);
+    const float scale = length(gConstants.worldX.xyz);
+    const float distance = length(center) * scale;
+    const float time = gConstants.view.z;
+
+    // Water nearby: a ring of looks into the water mask, about 260 world units round the point (on screen),
+    // and the point itself. The mist settles at the water's height.
+    float nearWater = 0.0f;
+    float waterY = 0.0f;
+    if (gConstants.water.y > 0.5f) {
+        const float height = gConstants.projection.w;
+        const float radius = clamp((260.0f / scale) * gConstants.projection.y * 0.5f * height / max(-center.z, 1e-3f), 3.0f, height * 0.2f);
+        float found = 0.0f;
+        for (int i = 0; i < 9; i++) {
+            const float angle = float(i) * 0.6981317f;
+            const float2 offset = (i == 8) ? float2(0.0f, 0.0f) : float2(cos(angle), sin(angle)) * radius * ((i & 1) ? 1.0f : 0.5f);
+            const int2 at = pixel + int2(offset);
+            float waterDepth;
+            if (LoadWater(at, waterDepth)) {
+                found += 1.0f;
+                waterY += WorldPosition(ViewPosition(at, waterDepth)).y;
+            }
+        }
+        if (found > 0.0f) {
+            waterY /= found;
+            nearWater = saturate(found / 4.0f);
+        }
+    }
