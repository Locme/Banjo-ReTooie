+    // Banjo-Tooie (lib-patches/rt64.patch): the game loads one combined view-projection matrix, so this
+    // split is what every camera goes through. The near and far scale (p[2][2]) was taken from row 0 alone,
+    // vp[0][2] / -vp[0][3], and vp[0][3] is the x of the camera's facing. With the camera facing nearly along
+    // z that is a ratio of two tiny 16.16 fixed-point numbers, so the scale came out wrong by up to several
+    // percent for a frame or two, the depth of everything with it: far things (the sky) fell beyond the far
+    // plane and near things across the near plane, and the picture tore (handoff: "vertex explosion").
+    // The scale is now taken from the row with the largest facing component (at least 0.577 of a unit
+    // vector), so the ratio is exact to about 1e-5. TOOIE_OLD_VP_SPLIT=1 brings the old split back for an
+    // A/B comparison, and TOOIE_VP_SPLIT_LOG=1 logs any split whose product differs from the input.
+    static bool vpSplitOld() {
+        static const bool old = (getenv("TOOIE_OLD_VP_SPLIT") != nullptr);
+        return old;
+    }
+
+    static bool vpSplitLog() {
+        static const bool log = (getenv("TOOIE_VP_SPLIT_LOG") != nullptr);
+        return log;
+    }
+
     void matrixDecomposeViewProj(const hlslpp::float4x4 &vp, hlslpp::float4x4 &v, hlslpp::float4x4 &p) {
         v = hlslpp::float4x4::identity();
         p = hlslpp::float4x4::identity();
@@ -52,7 +74,16 @@ namespace RT64 {
         v[2][2] = -vp[2][3];
