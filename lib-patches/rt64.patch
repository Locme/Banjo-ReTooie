+    float3 below = scene;
+    float bentWater;
+    if (LoadWater(bent, bentWater)) {
+        const float bentDepth = LoadDepth(bent);
+        if ((bentDepth >= 0.99999f) || (-ViewPosition(bent, bentDepth).z > distance)) {
