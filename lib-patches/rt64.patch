+    // Gauss-Jordan elimination with partial pivoting; false when the matrix can't be inverted.
+    static bool InvertMatrix4(const double (&m)[4][4], double (&out)[4][4]) {
+        double a[4][8];
+        for (int r = 0; r < 4; r++) {
+            for (int c = 0; c < 4; c++) {
+                a[r][c] = m[r][c];
+                a[r][c + 4] = (r == c) ? 1.0 : 0.0;
+            }
+        }
+        for (int c = 0; c < 4; c++) {
+            int pivot = c;
+            for (int r = c + 1; r < 4; r++) {
+                if (std::abs(a[r][c]) > std::abs(a[pivot][c])) {
+                    pivot = r;
+                }
+            }
+            if (std::abs(a[pivot][c]) < 1e-12) {
+                return false;
+            }
+            if (pivot != c) {
+                for (int k = 0; k < 8; k++) {
+                    std::swap(a[c][k], a[pivot][k]);
+                }
+            }
+            const double d = a[c][c];
+            for (int k = 0; k < 8; k++) {
+                a[c][k] /= d;
+            }
+            for (int r = 0; r < 4; r++) {
+                if ((r != c) && (a[r][c] != 0.0)) {
+                    const double f = a[r][c];
+                    for (int k = 0; k < 8; k++) {
+                        a[r][k] -= f * a[c][k];
+                    }
+                }
+            }
+        }
+        for (int r = 0; r < 4; r++) {
+            for (int c = 0; c < 4; c++) {
