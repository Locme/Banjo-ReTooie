+    // Banjo-Tooie: the passes of real 3D grass blades a ground draw needs: the most any of its triangles facing up
+    // (any way, with edges) within the grass's reach needs (GrassGS.hlsl), or 0 for none. Level ground has no model transform, so its
+    // positions are already in the world.
+    static uint32_t grassBladePasses(const DrawData &drawData, const GameCall &call, const interop::FrameParams &frameParams, bool edges) {
+        const uint32_t start = call.meshDesc.faceIndicesStart;
+        const uint32_t end = start + call.callDesc.triangleCount * 3;
+        if (end > drawData.faceIndices.size()) {
+            return 0;
+        }
+        const hlslpp::float3 camera(frameParams.grassWorldX.w, frameParams.grassWorldY.w, frameParams.grassWorldZ.w);
+        const float reach = frameParams.grassParams.z;
+        uint32_t passes = 0;
+        for (uint32_t i = start; i < end; i += 3) {
+            hlslpp::float3 p[3];
+            for (uint32_t k = 0; k < 3; k++) {
+                const uint32_t v = drawData.faceIndices[i + k];
+                if ((v * 3 + 2) >= drawData.posFloats.size()) {
+                    return 0;
+                }
+                p[k] = hlslpp::float3(drawData.posFloats[v * 3 + 0], drawData.posFloats[v * 3 + 1], drawData.posFloats[v * 3 + 2]);
+            }
+            const hlslpp::float3 n = hlslpp::cross(p[1] - p[0], p[2] - p[0]);
+            const float nLength = float(hlslpp::length(n));
+            if ((nLength <= 1e-4f) || (!edges && (std::abs(float(n.y)) < 0.6f * nLength))) {
+                continue;
+            }
+            const hlslpp::float3 center = (p[0] + p[1] + p[2]) / 3.0f;
+            const float radius = std::max({ float(hlslpp::length(p[0] - center)), float(hlslpp::length(p[1] - center)), float(hlslpp::length(p[2] - center)) });
+            const float distanceToCamera = std::max(float(hlslpp::length(center - camera)) - radius, 0.0f);
+            if (distanceToCamera > reach) {
+                continue;
+            }
+            // The grid lies in the plane of the two axes the triangle faces least along (as GrassGS.hlsl).
+            const float ax = std::abs(float(n.x)), ay = std::abs(float(n.y)), az = std::abs(float(n.z));
+            const int u = ((ay >= ax) && (ay >= az)) ? 0 : ((ax >= az) ? 2 : 0);
+            const int w = ((ay >= ax) && (ay >= az)) ? 2 : 1;
+            auto axis = [](const hlslpp::float3 &v, int i) { return (i == 0) ? float(v.x) : ((i == 1) ? float(v.y) : float(v.z)); };
+            const float low[2] = { std::min({ axis(p[0], u), axis(p[1], u), axis(p[2], u) }), std::min({ axis(p[0], w), axis(p[1], w), axis(p[2], w) }) };
+            const float high[2] = { std::max({ axis(p[0], u), axis(p[1], u), axis(p[2], u) }), std::max({ axis(p[0], w), axis(p[1], w), axis(p[2], w) }) };
+            passes = std::max(passes, SceneGrassBladePasses(low, high, distanceToCamera, frameParams.grassBlades.x, frameParams.grassBlades.w));
+        }
+        return passes;
+    }
