+    rgb = float3(0.0f, 0.0f, 0.0f);
+    if ((uv.y < 0.04f) || (uv.y > 0.28f)) {
+        return false;
+    }
+
+    const float x = (uv.x - 0.1f) / 0.8f;
+    const float y = (uv.y - 0.04f) / 0.24f;
+    if ((x >= 0.0f) && (x < 1.0f) && (y > 0.2f) && (y < 0.8f)) {
+        const float cell = x * 10.0f;
+        if (frac(cell) > 0.15f) {
+            rgb = (floor(cell) + 1.0f) * 0.02f;
+        }
+    }
+
+    return true;
+}
+
+float4 ApplyPictureFilters(float4 color, float2 uv, float4 pos) {
+    if (gConstants.dither16 != 0) {
+        color.rgb = Dither16(color.rgb, uv, gConstants.dither16);
+    }
+
+    if (gConstants.colourblindMode != 0) {
+        color.rgb = Daltonize(color.rgb, gConstants.colourblindMode, gConstants.colourblindStrength);
+    }
+
+    if (gConstants.crt != 0) {
+        color.rgb = Crt(color.rgb, uv, pos);
+    }
+
+    float3 patternColor;
+    if ((gConstants.brightnessPattern != 0) && BrightnessPattern(pos, patternColor)) {
+        color.rgb = patternColor;
+    }
+
+    // Banjo-Tooie: the brightness gamma. At 1.0 (the default) the power would give the colour back as it is, so
+    // the three pow operations a pixel are skipped.
+    if (gConstants.brightnessGamma != 1.0f) {
+        color.rgb = pow(max(color.rgb, 0.0f), gConstants.brightnessGamma);
+    }
+    else {
+        color.rgb = max(color.rgb, 0.0f);
+    }
+    return color;
+}
+
 float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
 #ifdef PIXEL_ANTIALIASING
-    return PixelAntialiasing(uv);
+    return ApplyPictureFilters(PixelAntialiasing(uv), uv, pos);
 #else
-    return SampleInput((uv / gConstants.textureResolution) * gConstants.videoResolution);
+    return ApplyPictureFilters(SampleInput((uv / gConstants.textureResolution) * gConstants.videoResolution), uv, pos);
 #endif
 }
