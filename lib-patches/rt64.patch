+                frame.player[i] = effectsSettings.player[i];
+                frame.rippleX[i] = effectsSettings.rippleX[i];
+                frame.rippleZ[i] = effectsSettings.rippleZ[i];
+                frame.rippleAge[i] = effectsSettings.rippleAge[i];
