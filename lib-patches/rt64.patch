+            positions.resize(size_t(end) * 4, 0.0f);
+        }
+        size_t c = 0;
+        for (const auto &[start, triangles] : faceRanges) {
+            for (uint32_t i = start; i < start + triangles * 3; i++) {
+                float *p = positions.data() + size_t(drawData.faceIndices[i]) * 4;
+                if (store) {
+                    corners.insert(corners.end(), p, p + 4);
+                }
+                else {
+                    std::copy(corners.begin() + c, corners.begin() + c + 4, p);
+                    c += 4;
+                }
+            }
+        }
+    }
