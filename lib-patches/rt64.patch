+    // Banjo-Tooie: a fingerprint of deep snow's ground (its vertices' places, its faces and the edge ramp), for
+    // snowGroundVertices' cache.
+    static uint64_t snowGroundKey(const DrawData &drawData, const std::vector<std::pair<uint32_t, uint32_t>> &faceRanges, uint32_t first, uint32_t end, float ramp) {
+        uint64_t h = 0xCBF29CE484222325ull;
+        auto mix = [&h](uint32_t word) { h = (h ^ word) * 0x100000001B3ull; };
+        uint32_t bits;
+        std::memcpy(&bits, &ramp, sizeof(bits));
+        mix(bits);
+        mix(first);
+        mix(end);
+        for (size_t i = size_t(first) * 3; i < size_t(end) * 3; i++) {
+            std::memcpy(&bits, &drawData.posFloats[i], sizeof(bits));
+            mix(bits);
+        }
+        for (const auto &[start, triangles] : faceRanges) {
+            mix(start);
+            mix(triangles);
+            for (uint32_t i = start; i < start + triangles * 3; i++) {
+                mix(drawData.faceIndices[i]);
+            }
+        }
+        return h;
+    }
