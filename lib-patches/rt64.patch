diff --git a/src/tools/file_to_c/file_to_c.cmake b/src/tools/file_to_c/file_to_c.cmake
new file mode 100644
index 0000000..05cb897
--- /dev/null
+++ b/src/tools/file_to_c/file_to_c.cmake
@@ -0,0 +1,34 @@
+# The same output as file_to_c.cpp, for cross builds (Android) where a tool built for the target
+# cannot run on the build machine.
+# Usage: cmake -P file_to_c.cmake <input file> <array name> <output C file> <output C header>
+set(input_path "${CMAKE_ARGV3}")
+set(array_name "${CMAKE_ARGV4}")
+set(output_c_path "${CMAKE_ARGV5}")
+set(output_h_path "${CMAKE_ARGV6}")
+if (NOT output_h_path)
+    message(FATAL_ERROR "Usage: cmake -P file_to_c.cmake [input file] [array name] [output C file] [output C header]")
+endif()
+
+file(SIZE "${input_path}" size)
+if (size EQUAL 0)
+    message(FATAL_ERROR "Failed to open file ${input_path}! (Or it's empty)")
+endif()
+file(READ "${input_path}" hex HEX)
+string(REGEX REPLACE "([0-9a-f][0-9a-f])" "(char)0x\\1," bytes "${hex}")
+
+file(WRITE "${output_c_path}"
+    "#include <stddef.h>\n"
+    "extern const char ${array_name}[${size}];\n"
+    "const char ${array_name}[${size}] = {${bytes}};\n"
+    "extern const size_t ${array_name}_size;\n"
+    "const size_t ${array_name}_size = sizeof(${array_name}) / sizeof(${array_name}[0]);\n")
+file(WRITE "${output_h_path}"
+    "#ifdef __cplusplus\n"
+    "  extern \"C\" {\n"
+    "#endif\n"
+    "#include <stddef.h>\n"
+    "extern const char ${array_name}[${size}];\n"
+    "extern const size_t ${array_name}_size;\n"
+    "#ifdef __cplusplus\n"
+    "  }\n"
+    "#endif\n")
