+        const uint32_t depthAddress = gradeSettings.depthAddress;
+        const float sharpen = gradeSettings.sharpen;
+        gradeSettings = { enabled, look, exposure, contrast, saturation, warmth, vignette, grain, cropAspect, grid, dofStrength, depthAddress, sharpen };
+    }
+
+    void SetSharpening(float strength) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.sharpen = strength;
+    }
+
+    void SetPhotoDepthOfField(float strength, uint32_t depthAddress) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.dofStrength = strength;
+        gradeSettings.depthAddress = depthAddress;
+    }
+
+    PhotoGradeSettings GetPhotoGrade() {
+        const std::scoped_lock lock(gradeMutex);
+        return gradeSettings;
+    }
+
+    void SetPhotoFrame(float cropAspect, bool grid) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.cropAspect = cropAspect;
+        gradeSettings.grid = grid;
+    }
+
+    RenderTexture *PhotoGradeRenderer::apply(RenderDevice *device, RenderCommandList *commandList, const ShaderLibrary *shaderLibrary,
+        RenderTexture *input, RenderFormat format, uint32_t width, uint32_t height, bool forScreenshot, RenderTexture *depth)
+    {
+        PhotoGradeSettings settings;
+        {
+            const std::scoped_lock lock(gradeMutex);
+            settings = gradeSettings;
+        }
+
+        if (!settings.enabled) {
+            // Only the sharpening, if that.
+            const float sharpen = settings.sharpen;
+            settings = PhotoGradeSettings();
+            settings.sharpen = sharpen;
+            if (sharpen <= 0.0f) {
+                return input;
+            }
+        }
+
+        if ((input == nullptr) || (width == 0) || (height == 0) || (format != RenderTarget::colorBufferFormat(shaderLibrary->usesHDR))) {
+            return input;
+        }
+
+        if ((this->width != width) || (this->height != height) || (outputTexture == nullptr)) {
+            outputFramebuffer.reset();
+            outputTexture = device->createTexture(RenderTextureDesc::ColorTarget(width, height, format));
+            outputTexture->setName("Photo Grade Output");
+            const RenderTexture *output = outputTexture.get();
+            outputFramebuffer = device->createFramebuffer(RenderFramebufferDesc(&output, 1));
+            this->width = width;
+            this->height = height;
+        }
+
+        if (descriptorSet == nullptr) {
+            descriptorSet = std::make_unique<SmaaDescriptorSet>(shaderLibrary->samplerLibrary.linear.clampClamp.get(),
+                shaderLibrary->samplerLibrary.nearest.clampClamp.get(), device);
+        }
+
+        // Every slot gets a texture; the pass reads the first, and the second for depth of field.
+        descriptorSet->setTexture(descriptorSet->gTexture0, input, RenderTextureLayout::SHADER_READ);
+        descriptorSet->setTexture(descriptorSet->gTexture1, (depth != nullptr) ? depth : input, RenderTextureLayout::SHADER_READ);
+        descriptorSet->setTexture(descriptorSet->gTexture2, input, RenderTextureLayout::SHADER_READ);
+
+        interop::PhotoGradeCB constants;
+        constants.rtMetrics = { 1.0f / float(width), 1.0f / float(height), float(width), float(height) };
+        constants.tone = { settings.exposure, settings.contrast, settings.saturation, settings.warmth };
+        const float seconds = std::chrono::duration<float>(std::chrono::steady_clock::now() - startTime).count();
+        constants.effects = { settings.vignette, settings.grain, seconds, float(settings.look) };
+        constants.frame = { settings.cropAspect, (settings.grid && !forScreenshot) ? 1.0f : 0.0f, 0.0f, 0.0f };
+        constants.dof = { settings.dofStrength, (depth != nullptr) ? 1.0f : 0.0f, shaderLibrary->usesHDR ? 1.0f : 0.0f, settings.sharpen };
+
+        RenderTextureBarrier barriers[] = {
+            RenderTextureBarrier(input, RenderTextureLayout::SHADER_READ),
+            RenderTextureBarrier(outputTexture.get(), RenderTextureLayout::COLOR_WRITE),
+            RenderTextureBarrier((depth != nullptr) ? depth : input, RenderTextureLayout::SHADER_READ)
+        };
+
+        commandList->barriers(RenderBarrierStage::GRAPHICS, barriers, uint32_t(std::size(barriers)));
+        commandList->setFramebuffer(outputFramebuffer.get());
+        commandList->setPipeline(shaderLibrary->photoGrade.pipeline.get());
+        commandList->setGraphicsPipelineLayout(shaderLibrary->photoGrade.pipelineLayout.get());
+        commandList->setGraphicsDescriptorSet(descriptorSet->get(), 0);
+        commandList->setGraphicsPushConstants(0, &constants);
+        commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        commandList->setViewports(RenderViewport(0.0f, 0.0f, float(width), float(height)));
+        commandList->setScissors(RenderRect(0, 0, width, height));
+        commandList->drawInstanced(3, 1, 0, 0);
+        return outputTexture.get();
+    }
+};
diff --git a/src/render/rt64_photo_grade.h b/src/render/rt64_photo_grade.h
new file mode 100644
index 0000000..e403425
--- /dev/null
+++ b/src/render/rt64_photo_grade.h
@@ -0,0 +1,59 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include "rt64_descriptor_sets.h"
+#include "rt64_shader_library.h"
+
+namespace RT64 {
+    // Banjo-Tooie: photo mode's filters, drawn over the game image after SMAA and before the VI (so
+    // screenshots show them). Everything at 0 and enabled false leaves the picture alone.
+    struct PhotoGradeSettings {
+        bool enabled = false;
+        uint32_t look = 0;
+        float exposure = 0.0f;
+        float contrast = 0.0f;
+        float saturation = 0.0f;
+        float warmth = 0.0f;
+        float vignette = 0.0f;
+        float grain = 0.0f;
+        float cropAspect = 0.0f;
+        bool grid = false;
+        float dofStrength = 0.0f;
+        uint32_t depthAddress = 0;
+        float sharpen = 0.0f;
+    };
+
+    void SetPhotoGrade(bool enabled, uint32_t look, float exposure, float contrast, float saturation, float warmth, float vignette, float grain);
+
+    // The crop frame (width / height, 0 for none; outside it is shaded) and the rule-of-thirds grid.
+    // The grid is left out of the frame a screenshot is taken from.
+    void SetPhotoFrame(float cropAspect, bool grid);
+
+    // Depth of field (0 off, 1 strongest), focused on the nearest thing at the middle of the picture.
+    // depthAddress is the game's depth buffer in RDRAM, whose render target gives the scene's depth.
+    void SetPhotoDepthOfField(float strength, uint32_t depthAddress);
+    // Sharpening (0 off, 1 strongest), a contrast-adaptive sharpen drawn in the same pass. It is kept
+    // apart from the filters above, which photo mode and the game's picture settings take turns to set.
+    void SetSharpening(float strength);
+
+    // The depth of field strength and depth buffer address last set (strength 0 while photo mode is off).
+    PhotoGradeSettings GetPhotoGrade();
+
+    struct PhotoGradeRenderer {
+        std::unique_ptr<RenderTexture> outputTexture;
+        std::unique_ptr<RenderFramebuffer> outputFramebuffer;
+        std::unique_ptr<SmaaDescriptorSet> descriptorSet;
+        uint32_t width = 0;
+        uint32_t height = 0;
+
+        // Records the pass and returns the graded image, or the input itself when the filters are off.
+        // forScreenshot leaves the grid out.
+        // depth, when not null, holds the scene's depth as RT64's depth-to-color copy writes it (an RGBA16
+        // depth value per pixel) at the input's size.
+        RenderTexture *apply(RenderDevice *device, RenderCommandList *commandList, const ShaderLibrary *shaderLibrary,
+            RenderTexture *input, RenderFormat format, uint32_t width, uint32_t height, bool forScreenshot, RenderTexture *depth);
+    };
+};
diff --git a/src/render/rt64_scene_effects.cpp b/src/render/rt64_scene_effects.cpp
new file mode 100644
index 0000000..616d4cd
--- /dev/null
+++ b/src/render/rt64_scene_effects.cpp
@@ -0,0 +1,279 @@
+//
+// RT64
+//
+
+#include "rt64_scene_effects.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include "shared/rt64_scene_effects.h"
+
+#include "rt64_render_target.h"
+
+namespace RT64 {
+    namespace {
+        // Test aid: TOOIE_SCENE_FX_VIEW=1 shows the effects alone as grey.
+        const bool debugView = (std::getenv("TOOIE_SCENE_FX_VIEW") != nullptr);
+        std::mutex effectsMutex;
+        SceneEffectsSettings effectsSettings;
+
+        // The pass's own textures and descriptor sets. Ones replaced after a resize are kept (not freed)
+        // since frames still in flight may use them; resizes are rare.
+        struct Resources {
+            std::unique_ptr<RenderTexture> bloomTexture[2];
+            std::unique_ptr<RenderFramebuffer> bloomFramebuffer[2];
+            std::unique_ptr<SmaaDescriptorSet> bloomSet[2];
+            uint32_t bloomWidth = 0;
+            uint32_t bloomHeight = 0;
+            std::unique_ptr<RenderTexture> copyTexture;
+            uint32_t copyWidth = 0;
+            uint32_t copyHeight = 0;
+            std::unique_ptr<SmaaDescriptorSet> sourceSet;
+            const RenderTexture *sourceSetTexture = nullptr;
+            std::unique_ptr<SceneEffectsDescriptorSet> sceneSet;
+            const RenderTexture *sceneSetDepth = nullptr;
+            const RenderTexture *sceneSetBloom = nullptr;
+            const RenderTexture *sceneSetColor = nullptr;
+            std::vector<std::unique_ptr<RenderTexture>> retired;
+            std::vector<std::unique_ptr<RenderFramebuffer>> retiredFramebuffers;
+            std::vector<std::unique_ptr<SmaaDescriptorSet>> retiredSets;
+            std::vector<std::unique_ptr<SceneEffectsDescriptorSet>> retiredSceneSets;
+
+            void retire() {
+                for (int i = 0; i < 2; i++) {
+                    if (bloomTexture[i] != nullptr) {
+                        retired.emplace_back(std::move(bloomTexture[i]));
+                        retiredFramebuffers.emplace_back(std::move(bloomFramebuffer[i]));
+                        retiredSets.emplace_back(std::move(bloomSet[i]));
+                    }
+                }
+            }
+        };
+
+        // Each worker that records the pass (the workload thread, and the game's thread when it syncs a
+        // framebuffer) gets its own, since they record at the same time.
+        std::mutex resourcesMutex;
+        std::unordered_map<RenderWorker *, std::unique_ptr<Resources>> workerResources;
+
+        Resources &resourcesFor(RenderWorker *worker) {
+            const std::scoped_lock lock(resourcesMutex);
+            std::unique_ptr<Resources> &resources = workerResources[worker];
+            if (resources == nullptr) {
+                resources = std::make_unique<Resources>();
+            }
+            return *resources;
+        }
+    }
+
+    void SetSceneEffects(float ambientOcclusion, float radius, uint32_t depthAddress) {
+        const std::scoped_lock lock(effectsMutex);
+        effectsSettings.ambientOcclusion = ambientOcclusion;
+        effectsSettings.ambientOcclusionRadius = radius;
+        effectsSettings.depthAddress = depthAddress;
+    }
+
+    void SetSceneFog(float fog, float start, float length, float red, float green, float blue) {
+        const std::scoped_lock lock(effectsMutex);
+        effectsSettings.fog = fog;
+        effectsSettings.fogStart = start;
+        effectsSettings.fogLength = length;
+        effectsSettings.fogColor[0] = red;
+        effectsSettings.fogColor[1] = green;
+        effectsSettings.fogColor[2] = blue;
+    }
+
+    void SetSceneBloom(float bloom, float threshold) {
+        const std::scoped_lock lock(effectsMutex);
+        effectsSettings.bloom = bloom;
+        effectsSettings.bloomThreshold = threshold;
+    }
+
+    void SetSceneDepthOfField(float strength) {
+        const std::scoped_lock lock(effectsMutex);
+        effectsSettings.depthOfField = strength;
+    }
+
+    void SetSceneOutlines(float outlines) {
+        const std::scoped_lock lock(effectsMutex);
+        effectsSettings.outlines = outlines;
+    }
+
+    SceneEffectsSettings GetSceneEffects() {
+        const std::scoped_lock lock(effectsMutex);
+        return effectsSettings;
+    }
+
+    bool SceneEffectsWanted(const RenderTarget *depthTarget) {
+        const SceneEffectsSettings settings = GetSceneEffects();
+        return ((settings.ambientOcclusion > 0.0f) || (settings.fog > 0.0f) || (settings.outlines > 0.0f) ||
+            (settings.bloom > 0.0f) || (settings.depthOfField > 0.0f)) && (settings.depthAddress != 0) && (depthTarget != nullptr) &&
+            (depthTarget->addressForName == settings.depthAddress);
+    }
+
+    void RecordSceneEffects(RenderWorker *worker, RenderTarget *colorTarget, RenderTarget *depthTarget,
+        const interop::float4x4 &projection, const ShaderLibrary *shaderLibrary)
+    {
+        const SceneEffectsSettings settings = GetSceneEffects();
+
+        // The game's matrices are row-vector (clip = v * M), so w = -z comes from m[2][3]; take the
+        // transposed terms if the matrix is the other way round.
+        const float (&m)[4][4] = projection.m;
+        const bool rowVector = std::abs(m[2][3] + 1.0f) <= std::abs(m[3][2] + 1.0f);
+        if ((std::abs(m[2][3] + 1.0f) > 0.01f) && (std::abs(m[3][2] + 1.0f) > 0.01f)) {
+            // Not a perspective projection after all (the game can briefly set others).
+            return;
+        }
+        interop::SceneEffectsCB constants;
+        constants.depthTerms = rowVector ? interop::float4{ m[2][2], m[3][2], m[2][3], m[3][3] } : interop::float4{ m[2][2], m[2][3], m[3][2], m[3][3] };
+        constants.projection = { m[0][0], m[1][1], float(colorTarget->width), float(colorTarget->height) };
+        constants.ambientOcclusion = { settings.ambientOcclusion, settings.ambientOcclusionRadius, debugView ? 1.0f : 0.0f, 0.0f };
+        constants.fog = { settings.fog, settings.fogStart, std::max(settings.fogLength, 1.0f), 0.0f };
+        constants.fogColor = { settings.fogColor[0], settings.fogColor[1], settings.fogColor[2], settings.outlines };
+
+        constants.bloom = { settings.bloom, settings.depthOfField, 0.0f, 0.0f };
+
+        RenderCommandList *commandList = worker->commandList.get();
+        Resources &res = resourcesFor(worker);
+        const RenderFormat format = RenderTarget::colorBufferFormat(shaderLibrary->usesHDR);
+        const uint32_t bloomWidth = std::max(colorTarget->width / 4, 1U);
+        const uint32_t bloomHeight = std::max(colorTarget->height / 4, 1U);
+        if ((res.bloomTexture[0] == nullptr) || (res.bloomWidth != bloomWidth) || (res.bloomHeight != bloomHeight)) {
+            res.retire();
+            for (int i = 0; i < 2; i++) {
+                res.bloomTexture[i] = worker->device->createTexture(RenderTextureDesc::ColorTarget(bloomWidth, bloomHeight, format));
+                res.bloomTexture[i]->setName("Scene Effects Bloom");
+                const RenderTexture *texture = res.bloomTexture[i].get();
+                res.bloomFramebuffer[i] = worker->device->createFramebuffer(RenderFramebufferDesc(&texture, 1));
+                res.bloomSet[i] = std::make_unique<SmaaDescriptorSet>(shaderLibrary->samplerLibrary.linear.clampClamp.get(),
+                    shaderLibrary->samplerLibrary.nearest.clampClamp.get(), worker->device);
+                res.bloomSet[i]->setTexture(res.bloomSet[i]->gTexture0, texture, RenderTextureLayout::SHADER_READ);
+                res.bloomSet[i]->setTexture(res.bloomSet[i]->gTexture1, texture, RenderTextureLayout::SHADER_READ);
+                res.bloomSet[i]->setTexture(res.bloomSet[i]->gTexture2, texture, RenderTextureLayout::SHADER_READ);
+            }
+            res.bloomWidth = bloomWidth;
+            res.bloomHeight = bloomHeight;
+            commandList->barriers(RenderBarrierStage::GRAPHICS, {
+                RenderTextureBarrier(res.bloomTexture[0].get(), RenderTextureLayout::SHADER_READ),
+                RenderTextureBarrier(res.bloomTexture[1].get(), RenderTextureLayout::SHADER_READ)
+            });
+        }
+
+        RenderTexture *source = nullptr;
+        if ((settings.bloom > 0.0f) || (settings.depthOfField > 0.0f)) {
+            // The scene so far, without multisampling: the target's resolve, or a copy of the target.
+            const RenderTextureView *sourceView = nullptr;
+            if (colorTarget->usesResolve()) {
+                colorTarget->markForResolve();
+                colorTarget->resolveTarget(worker, shaderLibrary);
+                source = colorTarget->getResolvedTexture();
+                sourceView = colorTarget->getResolvedTextureView();
+            }
+            else {
+                if ((res.copyTexture == nullptr) || (res.copyWidth != colorTarget->width) || (res.copyHeight != colorTarget->height)) {
+                    if (res.copyTexture != nullptr) {
+                        res.retired.emplace_back(std::move(res.copyTexture));
+                    }
+                    res.copyTexture = worker->device->createTexture(RenderTextureDesc::ColorTarget(colorTarget->width, colorTarget->height, format));
+                    res.copyTexture->setName("Scene Effects Copy");
+                    res.copyWidth = colorTarget->width;
+                    res.copyHeight = colorTarget->height;
+                }
+
+                commandList->barriers(RenderBarrierStage::COPY, {
+                    RenderTextureBarrier(colorTarget->texture.get(), RenderTextureLayout::COPY_SOURCE),
+                    RenderTextureBarrier(res.copyTexture.get(), RenderTextureLayout::COPY_DEST)
+                });
+                commandList->copyTexture(res.copyTexture.get(), colorTarget->texture.get());
+                source = res.copyTexture.get();
+            }
+
+            if ((res.sourceSet == nullptr) || (res.sourceSetTexture != source)) {
+                if (res.sourceSet != nullptr) {
+                    res.retiredSets.emplace_back(std::move(res.sourceSet));
+                }
+                res.sourceSet = std::make_unique<SmaaDescriptorSet>(shaderLibrary->samplerLibrary.linear.clampClamp.get(),
+                    shaderLibrary->samplerLibrary.nearest.clampClamp.get(), worker->device);
+                res.sourceSet->setTexture(res.sourceSet->gTexture0, source, RenderTextureLayout::SHADER_READ, sourceView);
+                res.sourceSet->setTexture(res.sourceSet->gTexture1, source, RenderTextureLayout::SHADER_READ, sourceView);
+                res.sourceSet->setTexture(res.sourceSet->gTexture2, source, RenderTextureLayout::SHADER_READ, sourceView);
+                res.sourceSetTexture = source;
+            }
+
+            commandList->barriers(RenderBarrierStage::GRAPHICS, {
+                RenderTextureBarrier(source, RenderTextureLayout::SHADER_READ)
+            });
+        }
+
+        if (settings.bloom > 0.0f) {
+            // Bright parts at a quarter of the size into [0], blurred across into [1], then down into [0].
+            auto bloomPass = [&](const SmaaDescriptorSet *input, RenderTexture *inputTexture, int output, uint32_t inputWidth, uint32_t inputHeight, float pass) {
+                commandList->barriers(RenderBarrierStage::GRAPHICS, {
+                    RenderTextureBarrier(inputTexture, RenderTextureLayout::SHADER_READ),
+                    RenderTextureBarrier(res.bloomTexture[output].get(), RenderTextureLayout::COLOR_WRITE)
+                });
+
+                interop::BloomCB bloomConstants;
+                bloomConstants.params = { 1.0f / float(inputWidth), 1.0f / float(inputHeight), pass, settings.bloomThreshold };
+                commandList->setFramebuffer(res.bloomFramebuffer[output].get());
+                commandList->setViewports(RenderViewport(0.0f, 0.0f, float(bloomWidth), float(bloomHeight)));
+                commandList->setScissors(RenderRect(0, 0, bloomWidth, bloomHeight));
+                commandList->setPipeline(shaderLibrary->bloom.pipeline.get());
+                commandList->setGraphicsPipelineLayout(shaderLibrary->bloom.pipelineLayout.get());
+                commandList->setGraphicsDescriptorSet(input->get(), 0);
+                commandList->setGraphicsPushConstants(0, &bloomConstants);
+                commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+                commandList->drawInstanced(3, 1, 0, 0);
+            };
+
+            bloomPass(res.sourceSet.get(), source, 0, colorTarget->width, colorTarget->height, 0.0f);
+            bloomPass(res.bloomSet[0].get(), res.bloomTexture[0].get(), 1, bloomWidth, bloomHeight, 1.0f);
+            bloomPass(res.bloomSet[1].get(), res.bloomTexture[1].get(), 0, bloomWidth, bloomHeight, 2.0f);
+        }
+
+        // The pass's inputs: the depth target, the bloom and the scene so far (the bloom stands in when unused).
+        const RenderTexture *color = (source != nullptr) ? source : res.bloomTexture[0].get();
+        if ((res.sceneSet == nullptr) || (res.sceneSetDepth != depthTarget->texture.get()) || (res.sceneSetBloom != res.bloomTexture[0].get()) ||
+            (res.sceneSetColor != color)) {
+            if (res.sceneSet != nullptr) {
+                res.retiredSceneSets.emplace_back(std::move(res.sceneSet));
+            }
+            res.sceneSet = std::make_unique<SceneEffectsDescriptorSet>(shaderLibrary->samplerLibrary.linear.clampClamp.get(), worker->device);
+            res.sceneSet->setTexture(res.sceneSet->gInput, depthTarget->texture.get(), RenderTextureLayout::SHADER_READ, depthTarget->textureView.get());
+            res.sceneSet->setTexture(res.sceneSet->gBloom, res.bloomTexture[0].get(), RenderTextureLayout::SHADER_READ);
+            res.sceneSetDepth = depthTarget->texture.get();
+            res.sceneSet->setTexture(res.sceneSet->gColor, color, RenderTextureLayout::SHADER_READ,
+                ((source != nullptr) && colorTarget->usesResolve()) ? colorTarget->getResolvedTextureView() : nullptr);
+            res.sceneSetBloom = res.bloomTexture[0].get();
+            res.sceneSetColor = color;
+        }
+
+        colorTarget->setupColorFramebuffer(worker);
+        commandList->barriers(RenderBarrierStage::GRAPHICS, {
+            RenderTextureBarrier(colorTarget->texture.get(), RenderTextureLayout::COLOR_WRITE),
+            RenderTextureBarrier(depthTarget->texture.get(), RenderTextureLayout::SHADER_READ),
+            RenderTextureBarrier(res.bloomTexture[0].get(), RenderTextureLayout::SHADER_READ)
+        });
+
+        commandList->setFramebuffer(colorTarget->textureFramebuffer.get());
+        commandList->setViewports(RenderViewport(0.0f, 0.0f, float(colorTarget->width), float(colorTarget->height)));
+        commandList->setScissors(RenderRect(0, 0, colorTarget->width, colorTarget->height));
+        commandList->setPipeline(shaderLibrary->sceneEffects.pipeline.get());
+        commandList->setGraphicsPipelineLayout(shaderLibrary->sceneEffects.pipelineLayout.get());
+        commandList->setGraphicsDescriptorSet(res.sceneSet->get(), 0);
+        commandList->setGraphicsPushConstants(0, &constants);
+        commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        commandList->drawInstanced(3, 1, 0, 0);
+
+        commandList->barriers(RenderBarrierStage::GRAPHICS, {
+            RenderTextureBarrier(depthTarget->texture.get(), RenderTextureLayout::DEPTH_WRITE)
+        });
+
+        // The HUD drawn next changes the picture again, so the target needs resolving again for display.
+        colorTarget->markForResolve();
+    }
+};
diff --git a/src/render/rt64_scene_effects.h b/src/render/rt64_scene_effects.h
new file mode 100644
index 0000000..7f74a9a
--- /dev/null
+++ b/src/render/rt64_scene_effects.h
@@ -0,0 +1,53 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include "shared/rt64_hlsl.h"
+
+#include "rt64_render_worker.h"
+#include "rt64_shader_library.h"
+
+namespace RT64 {
+    struct RenderTarget;
+
+    // Banjo-Tooie: screen-space effects (ambient occlusion, fog, outlines, bloom, depth of field) drawn over the 3D world after its last perspective draw and
+    // before the HUD, only into the framebuffer whose depth buffer is at depthAddress (the game's).
+    struct SceneEffectsSettings {
+        float ambientOcclusion = 0.0f;
+        float ambientOcclusionRadius = 60.0f;
+        uint32_t depthAddress = 0;
+        float fog = 0.0f;
+        float fogStart = 1000.0f;
+        float fogLength = 3000.0f;
+        float fogColor[3] = { 0.75f, 0.8f, 0.85f };
+        float outlines = 0.0f;
+        float bloom = 0.0f;
+        float bloomThreshold = 0.7f;
+        float depthOfField = 0.0f;
+    };
+
+    // ambientOcclusion: 0 off, 1 strongest. radius in world units. depthAddress is physical.
+    void SetSceneEffects(float ambientOcclusion, float radius, uint32_t depthAddress);
+    // fog: 0 off, 1 the most. start and length in world units; color in 0 to 1.
+    void SetSceneFog(float fog, float start, float length, float red, float green, float blue);
+    // Toon outlines where the depth jumps (silhouettes and creases): 0 off, 1 strongest.
+    void SetSceneOutlines(float outlines);
+    // Bloom: a glow around the bright parts of the scene (0 off, 1 strongest), from the parts brighter
+    // than the threshold (0 to 1).
+    void SetSceneBloom(float bloom, float threshold);
+    // Depth of field (0 off, 1 strongest), focused on the nearest thing at the middle of the picture.
+    void SetSceneDepthOfField(float strength);
+    SceneEffectsSettings GetSceneEffects();
+
+    // Whether the effects should be drawn into a framebuffer with this depth target.
+    bool SceneEffectsWanted(const RenderTarget *depthTarget);
+
+    // Draws the effects into the color target from the depth target, during a framebuffer's drawing.
