+                layerMatrixIds.push_back(hit.matrixId);
+            }
+        }
+        pickLayers = uint32_t(layers.size());
+        pickHash = layers.empty() ? 0 : layers[pickLayer % layers.size()];
+        pickMatrixId = layers.empty() ? 0 : layerMatrixIds[pickLayer % layers.size()];
