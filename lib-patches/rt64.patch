+        triangles.clear();
+        for (uint32_t i = start; i < end; i += 3) {
+            float p[9];
+            bool valid = true;
+            for (uint32_t k = 0; (k < 3) && valid; k++) {
+                const uint32_t v = drawData.faceIndices[i + k];
+                if (((v * 3 + 2) >= drawData.posFloats.size()) || (v >= drawData.worldIndices.size()) || (drawData.worldIndices[v] >= drawData.worldTransforms.size())) {
+                    valid = false;
+                    break;
+                }
+                const float (&m)[4][4] = drawData.worldTransforms[drawData.worldIndices[v]].m;
+                const float x = drawData.posFloats[v * 3 + 0], y = drawData.posFloats[v * 3 + 1], z = drawData.posFloats[v * 3 + 2];
