+
+// Modern water's waterfalls: the game's own fall, a little thicker and brighter in its white water.
+float3 ModernFall(int2 pixel, float3 original, float4 game) {
+    // The game's own fall texture and its scrolling are kept (they move smoothly at any frame rate);
+    // its white water is lifted a little and the fall drawn a touch thicker, with a soft glow from the sun.
+    const float luma = dot(game.rgb, float3(0.299f, 0.587f, 0.114f));
+    const float white = saturate((luma - 0.5f) * 2.5f);
+    float3 color = lerp(original, game.rgb, 0.2f * saturate(game.a + 0.25f));
+    const float3 sun = (gConstants.sun.z < 0.98f) ? gConstants.sun.xyz : normalize(float3(0.3f, 0.8f, -0.5f));
