+        for (uint32_t i = 0; i < SceneEffectsSoloCount; i++) {
+            if (i == kept) {
+                if (*strengths[i] <= 0.0f) {
+                    *strengths[i] = 0.5f;
+                }
+            }
+            else {
+                *strengths[i] = 0.0f;
+            }
+        }
+        if (kept != 10) {
+            solo.underwaterHaze = 0.0f;
+        }
+        else if (solo.underwaterHaze <= 0.0f) {
+            solo.underwaterHaze = 0.3f;
+        }
+        return solo;
+    }
