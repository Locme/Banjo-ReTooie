-        p[2][2] = vp[0][2] / v[0][2];
+        int scaleRow = 0;
+        if (!vpSplitOld()) {
+            for (int i = 1; i < 3; i++) {
+                if (abs(float(v[i][2])) > abs(float(v[scaleRow][2]))) {
+                    scaleRow = i;
+                }
+            }
+        }
+
+        p[2][2] = vp[scaleRow][2] / v[scaleRow][2];
         p[3][2] = vp[3][2] - p[2][2] * v[3][2];
 
         p[0][0] = sqrtf(sqr(vp[0][0]) + sqr(vp[1][0]) + sqr(vp[2][0]));
@@ -72,6 +103,21 @@ namespace RT64 {
             v = hlslpp::float4x4::identity();
             p = vp;
         }
+
+        if (vpSplitLog()) {
+            const hlslpp::float4x4 product = hlslpp::mul(v, p);
+            float worst = 0.0f;
+            for (int i = 0; i < 4; i++) {
+                for (int j = 0; j < 4; j++) {
+                    worst = std::max(worst, abs(float(product[i][j] - vp[i][j])));
+                }
+            }
