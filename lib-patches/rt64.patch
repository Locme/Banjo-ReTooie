 namespace RT64 {
+    // Banjo-Tooie: filters applied to the final picture as the VI draws it to the window.
+    struct PictureFilters {
+        // Brightness steps, -5 to +5: out = in^(1 / (1 + 0.08 * step)), so black and white stay put.
+        int brightness = 0;
+        // Draws ten grey boxes (2% to 20%) over the picture to set the brightness by.
+        bool brightnessPattern = false;
+        // 0 off, 1 deuteranopia, 2 protanopia, 3 tritanopia (daltonization), with a strength of 0 to 1.
+        uint32_t colourblindMode = 0;
+        float colourblindStrength = 1.0f;
+        // 240 scanlines with an aperture grille.
+        bool crt = false;
+        // 5 bits per channel with the N64's dither pattern: 0 off, 1 with the VI's dither filter (as the
+        // console shows it), 2 the raw dither.
+        uint32_t dither16 = 0;
+        // Off: textures are smoothed with plain bilinear filtering instead of the N64's 3-point filter.
+        bool threePointFiltering = true;
+    };
+
+    // Plain arguments, so the game can declare it without RT64's headers.
+    void SetPictureFilters(int brightness, bool brightnessPattern, uint32_t colourblindMode, float colourblindStrength, bool crt, uint32_t dither16, bool threePointFiltering);
