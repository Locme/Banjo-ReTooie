+    // Banjo-Tooie: Banjo's fur. Adds each triangle's normal (by its area) to its three vertices, in world space.
+    void FramebufferRenderer::addFurNormals(const DrawData &drawData, uint32_t faceIndexStart, uint32_t triangleCount) {
