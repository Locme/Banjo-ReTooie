+    // water. Each thickens with how far the view runs through it: across the water it builds up, looking down
+    // through it from above it stays thin.
+    const float cameraY = gConstants.worldY.w;
+    const float groundTop = gConstants.rippleAge.w + 140.0f;
+    const float groundRun = (world.y < groundTop) ? distance * ((cameraY > groundTop) ? (groundTop - world.y) / max(cameraY - world.y, 1.0f) : 1.0f) : 0.0f;
+    const float waterTop = waterY + 70.0f;
+    const float waterRun = ((nearWater > 0.0f) && (world.y < waterTop)) ? distance * ((cameraY > waterTop) ? (waterTop - world.y) / max(cameraY - world.y, 1.0f) : 1.0f) : 0.0f;
+    const float thickness = groundRun * (0.2f + 0.8f * banks) / 1600.0f + waterRun * nearWater * (0.45f + 0.55f * banks) / 1400.0f;
