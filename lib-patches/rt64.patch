+
+// mode 1: as the console shows it, with the VI dither filter. mode 2: the raw dither, with the VI filter off.
+float3 Dither16(float3 rgb, float2 uv, uint mode) {
+    const int2 pixel = int2(uv * gConstants.sdResolution);
+    const float3 center = Quantize16(rgb, pixel);
+    if (mode == 2) {
+        return (center * 8.0f + floor(center / 4.0f)) / 255.0f;
+    }
+
+
+    float3 restore = float3(0.0f, 0.0f, 0.0f);
+    for (int y = -1; y <= 1; y++) {
+        for (int x = -1; x <= 1; x++) {
+            if ((x == 0) && (y == 0)) {
+                continue;
+            }
+
+            const float2 neighbourUV = uv + float2(x, y) / gConstants.sdResolution;
+            const float3 neighbourColor = SampleInput((neighbourUV / gConstants.textureResolution) * gConstants.videoResolution).rgb;
+            restore += sign(Quantize16(neighbourColor, pixel + int2(x, y)) - center);
+        }
+    }
+
+    // 5 bits widened to 8 as the VI does, plus the dither filter's correction.
+    return saturate((center * 8.0f + floor(center / 4.0f) + restore) / 255.0f);
+}
+
+// 240 scanlines and an aperture grille (vertical red, green and blue stripes, 3 window pixels wide).
+float3 Crt(float3 rgb, float2 uv, float4 pos) {
+    const float scan = frac(uv.y * 240.0f);
+    const float scanline = lerp(0.55f, 1.0f, sin(scan * 3.14159265f));
+    const uint stripe = uint(pos.x) % 3;
+    const float3 mask = (stripe == 0) ? float3(1.0f, 0.7f, 0.7f) : ((stripe == 1) ? float3(0.7f, 1.0f, 0.7f) : float3(0.7f, 0.7f, 1.0f));
