+    // Banjo-Tooie: whether a draw is part of the level itself (one world matrix, the identity), not a model.
+    static bool levelGeometry(const DrawData &drawData, const GameCall &call) {
+        if ((call.callDesc.minWorldMatrix != call.callDesc.maxWorldMatrix) || (call.callDesc.minWorldMatrix >= drawData.worldTransforms.size())) {
+            return false;
+        }
+        const float (&w)[4][4] = drawData.worldTransforms[call.callDesc.minWorldMatrix].m;
+        for (int r = 0; r < 4; r++) {
+            for (int c = 0; c < 4; c++) {
+                if (std::abs(w[r][c] - ((r == c) ? 1.0f : 0.0f)) > 1e-3f) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
