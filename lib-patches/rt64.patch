+
+// Ten boxes from 2% to 20% grey on black, across the middle of the window. With the brightness right,
+// the first just vanishes and the second just shows.
+bool BrightnessPattern(float4 pos, out float3 rgb) {
+    const float2 uv = pos.xy / gConstants.windowResolution;
+    rgb = float3(0.0f, 0.0f, 0.0f);
+    if ((uv.y < 0.38f) || (uv.y > 0.62f)) {
+        return false;
+    }
