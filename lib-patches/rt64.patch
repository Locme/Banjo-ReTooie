+    // Slowly drifting banks, so the mist lies in patches rather than as an even haze.
+    const float2 drift = float2(0.012f, 0.005f) * time;
+    const float banks = smoothstep(0.3f, 0.75f, WaterNoise(world.xz / 900.0f + drift) * 0.65f + WaterNoise(world.xz / 260.0f - drift * 1.7f) * 0.35f);
