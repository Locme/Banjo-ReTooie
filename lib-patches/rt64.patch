+    const float h = WaterTessHeight(world, t, swell, 1.0f, player, velocity, 6.0f);
+    const float hx = WaterTessHeight(world + float3(e, 0.0f, 0.0f), t, swell, 1.0f, player, velocity, 6.0f);
