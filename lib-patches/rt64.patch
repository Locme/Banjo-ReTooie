 namespace RT64 {
@@ -29,6 +31,36 @@ namespace RT64 {
     static const uint32_t TextureDataPitchAlignment = 256;
     static const uint32_t TextureDataPlacementAlignment = 512;
 
+    // Banjo-Tooie: live texture upscaling. The upload thread notices a new generation and refreshes the cache.
+    static std::atomic<uint32_t> TextureUpscaleFactor = 1;
+    static std::atomic<uint32_t> TextureUpscaleGeneration = 0;
+    static const uint32_t TextureUpscaleMaxSize = 4096;
+
+    void SetTextureUpscale(uint32_t factor) {
+        factor = (factor >= 4) ? 4 : ((factor >= 2) ? 2 : 1);
+        if (TextureUpscaleFactor.exchange(factor) != factor) {
+            TextureUpscaleGeneration++;
+        }
+    }
+
+    uint32_t GetTextureUpscale() {
+        return TextureUpscaleFactor;
+    }
+
+    // Banjo-Tooie: a lower cap on the replacement pool while the texture sweep warps from map to map.
+    static std::atomic<uint64_t> ReplacementPoolLimit = 0;
