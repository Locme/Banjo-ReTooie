+
+float AoStrength() {
+    return float(IndirectPacked().x) / 100.0f;
+}
+
+float SsgiStrength() {
+    return float(IndirectPacked().y) / 100.0f;
+}
+
+float SsrStrength() {
+    return float(IndirectPacked().z) / 100.0f;
+}
