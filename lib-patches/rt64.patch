+# Banjo-Tooie: geometry shaders, for D3D12 and Vulkan only (Metal has none).
+function(build_geometry_shader TARGETOBJ SHADERNAME)
+    if (WIN32)
+        build_shader_dxil(${TARGETOBJ} ${SHADERNAME} "${DXC_GS_OPTS}" ${ARGN})
+    endif()
+    build_shader_spirv(${TARGETOBJ} ${SHADERNAME} "${DXC_GS_OPTS}" ${ARGN})
+endfunction()
+
+# Banjo-Tooie: hull and domain shaders (HSMain and DSMain of one file), for D3D12 and Vulkan only.
+function(build_tessellation_shaders TARGETOBJ SHADERNAME HSNAME DSNAME)
+    if (WIN32)
+        build_shader_dxil(${TARGETOBJ} ${SHADERNAME} "${DXC_HS_OPTS}" ${HSNAME})
+        build_shader_dxil(${TARGETOBJ} ${SHADERNAME} "${DXC_DS_OPTS}" ${DSNAME})
+    endif()
+    build_shader_spirv(${TARGETOBJ} ${SHADERNAME} "${DXC_HS_OPTS}" ${HSNAME})
+    build_shader_spirv(${TARGETOBJ} ${SHADERNAME} "${DXC_DS_OPTS}" ${DSNAME})
+endfunction()
+
+# Banjo-Tooie: instanced 3D grass's shaders (any stage), for D3D12 and Vulkan only.
+function(build_grass_shader TARGETOBJ SHADERNAME OPTIONS)
