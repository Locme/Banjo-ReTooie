+    // Banjo-Tooie: calls visit(cx, cz, height) for each cell of a grid (corner, cell size, cells along a side) whose
+    // centre a triangle of a draw facing up covers (its edges widened by edge cells), where its vertices' alpha is at
+    // least alphaMin.
+    // With ground (the grass ground's grid, GrassGroundScale cells to each of its cells; GrassGroundNone where there is
+    // none), only cells of it with grass at the triangle's height are gone over (most ground is nowhere near grass).
+    template <typename Visit>
+    static void visitGroundCells(const DrawData &drawData, const GameCall &call, float originX, float originZ, float cell, int cells,
+        float alphaMin, float edge, Visit &&visit, const std::vector<float> *ground = nullptr, float groundReach = 0.0f)
+    {
+        const uint32_t start = call.meshDesc.faceIndicesStart;
+        const uint32_t end = start + call.callDesc.triangleCount * 3;
+        if ((end > drawData.faceIndices.size()) || (cells <= 0)) {
+            return;
+        }
+        for (uint32_t i = start; i < end; i += 3) {
+            float x[3], y[3], z[3], a[3];
+            bool valid = true;
+            for (uint32_t k = 0; k < 3; k++) {
+                const uint32_t v = drawData.faceIndices[i + k];
+                if (((v * 3 + 2) >= drawData.posFloats.size()) || ((v * 4 + 3) >= drawData.normColBytes.size()) ||
+                    (v >= drawData.worldIndices.size()) || (drawData.worldIndices[v] >= drawData.worldTransforms.size()))
+                {
+                    valid = false;
+                    break;
+                }
+                const float (&m)[4][4] = drawData.worldTransforms[drawData.worldIndices[v]].m;
+                const float px = drawData.posFloats[v * 3 + 0], py = drawData.posFloats[v * 3 + 1], pz = drawData.posFloats[v * 3 + 2];
+                x[k] = (px * m[0][0] + py * m[1][0] + pz * m[2][0] + m[3][0] - originX) / cell;
+                y[k] = px * m[0][1] + py * m[1][1] + pz * m[2][1] + m[3][1];
+                z[k] = (px * m[0][2] + py * m[1][2] + pz * m[2][2] + m[3][2] - originZ) / cell;
+                a[k] = drawData.normColBytes[v * 4 + 3] / 255.0f;
+            }
+            if (!valid || ((a[0] < alphaMin) && (a[1] < alphaMin) && (a[2] < alphaMin))) {
+                continue;
+            }
+            // Facing up (or down: the game's winding varies), as the ground blades grow on.
+            const float e1x = x[1] - x[0], e1y = y[1] - y[0], e1z = z[1] - z[0];
+            const float e2x = x[2] - x[0], e2y = y[2] - y[0], e2z = z[2] - z[0];
+            // (In the world: x and z are in cells, y in world units.)
+            const float nx = (e1y * e2z - e1z * e2y) * cell, ny = (e1z * e2x - e1x * e2z) * cell * cell, nz = (e1x * e2y - e1y * e2x) * cell;
+            const float nLength = std::sqrt(nx * nx + ny * ny + nz * nz);
+            const float area = e1x * e2z - e1z * e2x;
+            if ((nLength <= 1e-6f) || (std::abs(ny) < 0.6f * nLength) || (std::abs(area) < 1e-6f)) {
+                continue;
+            }
+            const int x0 = std::max(int(std::floor(std::min({ x[0], x[1], x[2] }) - std::max(-edge, 0.0f))), 0);
+            const int x1 = std::min(int(std::ceil(std::max({ x[0], x[1], x[2] }) + std::max(-edge, 0.0f))), cells - 1);
+            const int z0 = std::max(int(std::floor(std::min({ z[0], z[1], z[2] }) - std::max(-edge, 0.0f))), 0);
+            const int z1 = std::min(int(std::ceil(std::max({ z[0], z[1], z[2] }) + std::max(-edge, 0.0f))), cells - 1);
+            // How far past an edge a point may lie, in each barycentric weight (edge cells along the triangle's sides).
+            const float sideX[3] = { x[2] - x[1], x[0] - x[2], x[1] - x[0] };
+            const float sideZ[3] = { z[2] - z[1], z[0] - z[2], z[1] - z[0] };
+            float slack[3];
+            for (int k = 0; k < 3; k++) {
+                const float sideLength = std::sqrt(sideX[k] * sideX[k] + sideZ[k] * sideZ[k]);
+                slack[k] = edge * sideLength / std::abs(area);
+            }
+            const float yLow = std::min({ y[0], y[1], y[2] }) - groundReach, yHigh = std::max({ y[0], y[1], y[2] }) + groundReach;
+            const int scale = (ground != nullptr) ? int(GrassGroundScale) : 1;
+            const int groundCells = cells / scale;
+            for (int bz = z0 / scale; bz <= z1 / scale; bz++) {
+            for (int bx = x0 / scale; bx <= x1 / scale; bx++) {
+                if (ground != nullptr) {
+                    const float h = (*ground)[size_t(bz) * size_t(groundCells) + size_t(bx)];
+                    if ((h < yLow) || (h > yHigh)) {
+                        continue;
+                    }
+                }
+            for (int cz = std::max(z0, bz * scale); cz <= std::min(z1, bz * scale + scale - 1); cz++) {
+                for (int cx = std::max(x0, bx * scale); cx <= std::min(x1, bx * scale + scale - 1); cx++) {
+                    const float px = cx + 0.5f, pz = cz + 0.5f;
+                    const float b1 = ((px - x[0]) * e2z - (pz - z[0]) * e2x) / area;
+                    const float b2 = ((pz - z[0]) * e1x - (px - x[0]) * e1z) / area;
+                    const float b0 = 1.0f - b1 - b2;
+                    if ((b0 < slack[0]) || (b1 < slack[1]) || (b2 < slack[2])) {
+                        continue;
+                    }
+                    const float w0 = std::clamp(b0, 0.0f, 1.0f), w1 = std::clamp(b1, 0.0f, 1.0f), w2 = std::clamp(b2, 0.0f, 1.0f);
+                    const float wSum = std::max(w0 + w1 + w2, 1e-6f);
+                    if (((w0 * a[0] + w1 * a[1] + w2 * a[2]) / wSum) < alphaMin) {
+                        continue;
+                    }
+                    visit(cx, cz, (w0 * y[0] + w1 * y[1] + w2 * y[2]) / wSum);
+                }
+            }
+            }
+            }
+        }
+    }
