+    // Banjo-Tooie: adds a level draw going into the traced scene to the target's fingerprint of them (rayLevelKey): its
+    // triangle count, its flags and its vertices' places (level ground is drawn in world space).
+    static void rayLevelMix(uint64_t &key, const DrawData &drawData, const GameCall &call, uint32_t flags) {
+        if ((flags & SceneRayDrawModel) != 0) {
+            return;
+        }
+        if (key == 0) {
+            key = 0xCBF29CE484222325ull;
+        }
+        auto mix = [&key](uint32_t word) { key = (key ^ word) * 0x100000001B3ull; };
+        mix(call.callDesc.triangleCount);
+        mix(flags);
+        const uint32_t start = call.meshDesc.faceIndicesStart;
+        for (uint32_t k = start; (k < start + call.callDesc.triangleCount * 3) && (k < drawData.faceIndices.size()); k++) {
+            const size_t v = size_t(drawData.faceIndices[k]) * 3;
+            for (size_t c = 0; (c < 3) && (v + c < drawData.posFloats.size()); c++) {
+                uint32_t bits;
+                std::memcpy(&bits, &drawData.posFloats[v + c], sizeof(bits));
+                mix(bits);
+            }
+        }
+    }
