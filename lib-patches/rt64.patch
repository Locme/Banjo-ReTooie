+        RenderTextureBarrier blendBarriers[] = {
+            RenderTextureBarrier(weightsTexture.get(), RenderTextureLayout::SHADER_READ),
+            RenderTextureBarrier(outputTexture.get(), RenderTextureLayout::COLOR_WRITE)
+        };
