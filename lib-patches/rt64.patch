diff --git a/src/shared/rt64_scene_effects.h b/src/shared/rt64_scene_effects.h
new file mode 100644
index 0000000..2f62a4f
--- /dev/null
+++ b/src/shared/rt64_scene_effects.h
@@ -0,0 +1,57 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include "shared/rt64_hlsl.h"
+
+#ifdef HLSL_CPU
+namespace interop {
+#endif
+    // Banjo-Tooie: screen-space effects drawn over the 3D world before the HUD (SceneEffectsPS.hlsl).
+    struct SceneEffectsCB {
+        // The projection's depth terms: ndc z = (a * z + b) / (c * z + d) for a view-space z. The depth is
+        // the projected z / w, in [0, 1] over the 3D world.
+        float4 depthTerms;
+        // The projection's x and y scales, then the target's width and height.
+        float4 projection;
+        // Ambient occlusion strength (0 off, 1 strongest), its radius in world units, unused, then the rim light strength (0 off, 1 strongest).
+        float4 ambientOcclusion;
+        // Fog strength (0 off, 1 the most), the distance it starts at, the distance over which it
+        // thickens, then the underwater tint (0 off: not under water, 1 strongest).
+        float4 fog;
+        // The fog's color (rgb), then the outline strength (0 off, 1 strongest).
+        float4 fogColor;
+        // The debug view (0 none, 1 the effects alone as grey, 2 depth, 3 normals, 4 water mask), 1 to draw the effects only
+        // on the left half of the picture (F8 compare), a time in seconds, then the heat haze (0 off,
+        // 1 strongest).
+        float4 view;
+        // Water reflections strength (0 off), 1 when the water mask was drawn this frame, bounce light (0 off,
+        // 1 strongest), then the water waves' strength (0 off, 1 strongest).
+        float4 water;
+        // Bloom strength (0 off), depth of field strength (0 off, 1 strongest), eye adaptation strength
+        // (0 off, 1 strongest), then the underwater haze (0 to 1).
+        float4 bloom;
+        // A view-space position's world x and z: dot(position, xyz) + w. Lets the water waves stay in place.
+        float4 worldX;
+        float4 worldZ;
+        // The same for world y: its xyz is also the normal of level ground, in view space.
+        float4 worldY;
+        // The light shafts' sun: its direction in view space (towards it), then the strength (0 off, 1 strongest).
+        float4 sun;
+        // Banjo's ripples: four rings' world x, world z and age in seconds (below 0 for none).
+        float4 rippleX;
+        float4 rippleZ;
+        float4 rippleAge;
+    };
+
+    // Banjo-Tooie: the bloom passes (BloomPS.hlsl): the source's texel size, the pass (0 bright parts at a
+    // quarter of the size, 1 blur across, 2 blur down, 3 measure the average brightness, 4 move the adapted
+    // brightness towards it), then the brightness threshold (0 to 1), or for pass 4 how far to move (0 to 1).
+    struct BloomCB {
+        float4 params;
+    };
+#ifdef HLSL_CPU
+};
+#endif
