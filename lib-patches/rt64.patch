+    // Banjo-Tooie: the grid of where 3D grass doesn't grow (FrameParams.grassMask): cells of 4 units, 1280 along each
+    // side round the camera, past the farthest the blades reach.
+    // Banjo-Tooie: TOOIE_GRASS_LOG=5: CPU time of the grass's work on the frame (collecting its triangles, the road grid,
+    // finishing the culling pass's input), printed with [grass-cull].
+    static double grassCollectMs = 0.0, grassMaskMs = 0.0, grassFinishMs = 0.0;
+    static uint32_t grassTimedFrames = 0;
+    static uint32_t grassMaskWorked = 0;
+    static uint64_t grassMaskHits = 0;
+    static double grassMaskMarkMs = 0.0;
