+    const float2 f = frac(p);
+    float nearest = 8.0f;
+    float second = 8.0f;
+    [loop] for (int j = -1; j <= 1; j++) {
+        [loop] for (int i = -1; i <= 1; i++) {
+            const float2 o = float2(float(i), float(j));
