+            }
+            if (valid && (std::abs(p[0] - frameParams.snowPlayer.x) < reach) && (std::abs(p[2] - frameParams.snowPlayer.y) < reach)) {
+                triangles.insert(triangles.end(), p, p + 9);
+            }
+        }
+        SceneSnowTouchDraw(triangles.data(), triangles.size() / 9);
