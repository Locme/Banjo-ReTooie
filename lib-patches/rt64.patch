+    normal = up;
+    const float strength = gConstants.water.w;
+    const float footprint = -surface.z * 2.0f / (gConstants.projection.y * gConstants.projection.w);
+    const float waterY = dot(surface, gConstants.worldY.xyz) + gConstants.worldY.w;
