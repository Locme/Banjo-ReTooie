diff --git a/src/shaders/BloomPS.hlsl b/src/shaders/BloomPS.hlsl
new file mode 100644
index 0000000..75eb198
--- /dev/null
+++ b/src/shaders/BloomPS.hlsl
@@ -0,0 +1,122 @@
+//
+// RT64
+//
+// Banjo-Tooie: the scene effects' bloom. Pass 0 keeps the bright parts of the scene at a quarter of its
+// size (four bilinear taps cover each 4x4 block), passes 1 and 2 blur them across and down, pass 5 takes
+// them down to an eighth for a wider glow and pass 6 adds the two. Passes 3
+// and 4 measure the scene's brightness and adapt to it over time for eye adaptation.
+
+#include "shared/rt64_scene_effects.h"
+
+[[vk::push_constant]] ConstantBuffer<BloomCB> gConstants : register(b0);
+
+Texture2D<float4> gTexture0 : register(t1);
+Texture2D<float4> gTexture1 : register(t2);
+Texture2D<float4> gTexture2 : register(t3);
+SamplerState LinearSampler : register(s4);
+SamplerState PointSampler : register(s5);
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    const float2 texel = gConstants.params.xy;
+    const uint pass = uint(gConstants.params.z + 0.5f);
+    if (pass == 3) {
+        // The scene's average brightness (geometric mean over a 16x16 grid), into one pixel.
+        float sum = 0.0f;
+        [loop] for (int y = 0; y < 16; y++) {
+            [loop] for (int x = 0; x < 16; x++) {
+                const float2 at = (float2(x, y) + 0.5f) / 16.0f;
+                const float3 c = saturate(gTexture0.SampleLevel(LinearSampler, at, 0).rgb);
+                sum += log(max(dot(c, float3(0.2126f, 0.7152f, 0.0722f)), 0.002f));
+            }
+        }
+        return float4(exp(sum / 256.0f), 0.0f, 0.0f, 1.0f);
+    }
+    else if (pass == 4) {
+        // The adapted brightness moves towards the measured one (gTexture0) from where it was (gTexture1);
+        // the measured one is kept beside it.
+        const float measured = gTexture0.Load(int3(0, 0, 0)).r;
+        const float previous = gTexture1.Load(int3(0, 0, 0)).r;
+        // Like eyes, getting used to the light is quick (half a second) and to the dark slow (four seconds), so
+        // the fades between areas barely move it; a black screen (a fade, a cut) doesn't move it at all.
+        const float seconds = -log(max(1.0f - gConstants.params.w, 1e-4f));
+        const float rate = (measured < 0.03f) ? 0.0f : (1.0f - exp(-seconds * ((measured > previous) ? 2.0f : 0.25f)));
+        const float adapted = (previous > 0.0f) ? lerp(previous, measured, rate) : measured;
+        return float4(adapted, measured, 0.0f, 1.0f);
+    }
+    if (pass == 7) {
+        // Modern water's ripples: one step of the wave equation on the grid (r height, g speed), read from where
+        // the grid was before it moved with the player, pushed down where the player is.
+        const int2 size = int2(round(1.0f / texel));
+        const int2 cell = int2(pos.xy);
+        const int2 from = cell + int2(gConstants.waterSim.xy);
+        float2 state = 0.0f;
+        float neighbours = 0.0f;
+        if (all(from >= 0) && all(from < size)) {
+            state = gTexture0.Load(int3(from, 0)).rg;
+            [unroll] for (int i = 0; i < 4; i++) {
+                const int2 n = from + ((i == 0) ? int2(1, 0) : (i == 1) ? int2(-1, 0) : (i == 2) ? int2(0, 1) : int2(0, -1));
+                neighbours += (all(n >= 0) && all(n < size)) ? gTexture0.Load(int3(n, 0)).r : 0.0f;
+            }
+        }
+        float h = state.r;
+        float v = state.g;
+        v += (neighbours - 4.0f * h) * 0.45f;
+        // The player: pushed down at their spot, softly round its edge.
+        const float d = length(float2(cell) + 0.5f - gConstants.waterSim.zw);
+        const float r = max(gConstants.waterPush.y, 1.0f);
+        v -= gConstants.waterPush.x * exp(-(d * d) / (r * r));
+        // A splash pushes a wider patch much harder for one step.
+        v -= gConstants.waterPush.z * exp(-(d * d) / (4.0f * r * r));
+        v *= gConstants.waterPush.w;
+        h = (h + v) * 0.9995f;
+        // Calm towards the grid's edges, so nothing reflects off them.
+        const float2 edge = min(float2(cell), float2(size - 1 - cell)) / (float2(size) * 0.12f);
+        const float calm = saturate(min(edge.x, edge.y));
+        return float4(h * calm, v * calm, 0.0f, 1.0f);
+    }
+    if (pass == 0) {
+        float3 color = 0.0f;
+        color += gTexture0.SampleLevel(LinearSampler, uv + texel * float2(-1.0f, -1.0f), 0).rgb;
+        color += gTexture0.SampleLevel(LinearSampler, uv + texel * float2(1.0f, -1.0f), 0).rgb;
+        color += gTexture0.SampleLevel(LinearSampler, uv + texel * float2(-1.0f, 1.0f), 0).rgb;
+        color += gTexture0.SampleLevel(LinearSampler, uv + texel * float2(1.0f, 1.0f), 0).rgb;
+        color = saturate(color * 0.25f);
+        // What is brighter than the threshold, easing in over a soft knee instead of switching on, so the
+        // glow doesn't flicker on textures right at the threshold. Measured on the brightness, so a fully
+        // saturated red or blue doesn't count as bright as white.
+        const float threshold = gConstants.params.w;
+        const float knee = 0.12f;
+        const float brightness = max(dot(color, float3(0.2126f, 0.7152f, 0.0722f)), max(color.r, max(color.g, color.b)) * 0.6f);
+        float soft = clamp(brightness - threshold + knee, 0.0f, 2.0f * knee);
+        soft = soft * soft / (4.0f * knee);
+        const float keep = max(soft, brightness - threshold) / max(brightness, 1e-4f);
+        return float4(color * keep, 1.0f);
+    }
+    else if (pass == 5) {
+        // Down to an eighth: four bilinear taps cover each 4x4 block of the quarter.
+        float3 color = 0.0f;
+        color += gTexture0.SampleLevel(LinearSampler, uv + texel * float2(-1.0f, -1.0f), 0).rgb;
+        color += gTexture0.SampleLevel(LinearSampler, uv + texel * float2(1.0f, -1.0f), 0).rgb;
+        color += gTexture0.SampleLevel(LinearSampler, uv + texel * float2(-1.0f, 1.0f), 0).rgb;
+        color += gTexture0.SampleLevel(LinearSampler, uv + texel * float2(1.0f, 1.0f), 0).rgb;
+        return float4(color * 0.25f, 1.0f);
+    }
+    else if (pass == 6) {
+        // The tight glow and the wide one together.
+        const float3 tight = gTexture0.SampleLevel(LinearSampler, uv, 0).rgb;
+        const float3 wide = gTexture1.SampleLevel(LinearSampler, uv, 0).rgb;
+        return float4(tight * 0.6f + wide * 0.9f, 1.0f);
+    }
+
+    // A 9-tap Gaussian, its taps spread 1.5 texels apart for a wider glow.
+    const float2 step = (pass == 1) ? float2(texel.x, 0.0f) : float2(0.0f, texel.y);
+    const float weights[5] = { 0.227027f, 0.1945946f, 0.1216216f, 0.054054f, 0.016216f };
+    float3 color = gTexture0.SampleLevel(LinearSampler, uv, 0).rgb * weights[0];
+    [unroll] for (int i = 1; i < 5; i++) {
+        const float2 offset = step * (1.5f * float(i));
+        color += gTexture0.SampleLevel(LinearSampler, uv + offset, 0).rgb * weights[i];
+        color += gTexture0.SampleLevel(LinearSampler, uv - offset, 0).rgb * weights[i];
+    }
+
+    return float4(color, 1.0f);
+}
diff --git a/src/shaders/FsrPS.hlsl b/src/shaders/FsrPS.hlsl
new file mode 100644
index 0000000..b4daa7f
--- /dev/null
+++ b/src/shaders/FsrPS.hlsl
@@ -0,0 +1,59 @@
+//
+// RT64
+//
+
+// Banjo-Tooie: AMD FidelityFX Super Resolution 1 on the finished game image, just before the VI draws it.
+// ffx_a.h and ffx_fsr1.h are AMD's (MIT), kept in the game's repository under lib/fsr. FSR_PASS_EASU
+// upscales to the window's size, FSR_PASS_RCAS sharpens the upscaled image.
+
+#include "shared/rt64_fsr.h"
+
+[[vk::push_constant]] ConstantBuffer<FsrCB> gConstants : register(b0);
+
+Texture2D<float4> gTexture0 : register(t1);
+Texture2D<float4> gTexture1 : register(t2);
+Texture2D<float4> gTexture2 : register(t3);
+SamplerState LinearSampler : register(s4);
+SamplerState PointSampler : register(s5);
+
+#define A_GPU 1
+#define A_HLSL 1
+#include "ffx_a.h"
+
+#if defined(FSR_PASS_EASU)
+#   define FSR_EASU_F 1
+// The 2x2 texels around p in Gather's order (x: bottom-left, y: bottom-right, z: top-right, w: top-left),
+// read one by one: Gather isn't reliable on every driver here.
+float4x4 gatherTexels(float2 p) {
+    const float2 texel = asfloat(gConstants.con1.xy);
+    const float2 topLeft = p - 0.5 * texel;
+    return float4x4(
+        gTexture0.SampleLevel(PointSampler, topLeft + float2(0.0, texel.y), 0),
+        gTexture0.SampleLevel(PointSampler, topLeft + texel, 0),
+        gTexture0.SampleLevel(PointSampler, topLeft + float2(texel.x, 0.0), 0),
+        gTexture0.SampleLevel(PointSampler, topLeft, 0));
+}
+
+AF4 FsrEasuRF(AF2 p) { const float4x4 t = gatherTexels(p); return AF4(t[0].r, t[1].r, t[2].r, t[3].r); }
+AF4 FsrEasuGF(AF2 p) { const float4x4 t = gatherTexels(p); return AF4(t[0].g, t[1].g, t[2].g, t[3].g); }
+AF4 FsrEasuBF(AF2 p) { const float4x4 t = gatherTexels(p); return AF4(t[0].b, t[1].b, t[2].b, t[3].b); }
+#else
+#   define FSR_RCAS_F 1
+AF4 FsrRcasLoadF(ASU2 p) { return gTexture0.Load(int3(p, 0)); }
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) { }
+#endif
+
+#include "ffx_fsr1.h"
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    const AU2 ip = AU2(pos.xy);
+#if defined(FSR_PASS_EASU)
+    AF3 color;
+    FsrEasuF(color, ip, gConstants.con0, gConstants.con1, gConstants.con2, gConstants.con3);
+    return float4(color, 1.0f);
+#else
+    AF1 r, g, b;
+    FsrRcasF(r, g, b, ip, gConstants.con0);
+    return float4(r, g, b, 1.0f);
+#endif
+}
diff --git a/src/shaders/FxaaPS.hlsl b/src/shaders/FxaaPS.hlsl
new file mode 100644
index 0000000..e0b28f6
--- /dev/null
+++ b/src/shaders/FxaaPS.hlsl
@@ -0,0 +1,160 @@
+//
+// RT64
+//
+
+// Banjo-Tooie: FXAA on the finished game image, before the VI draws it. A fast approximate anti-aliasing
+// pass written for this port after Timothy Lottes' FXAA idea: find a luma edge, its direction and its two
+// ends, then blend each pixel across the edge by how far it is from the nearer end. FXAA_EXTREME searches
+// further along edges and catches fainter ones, for a softer picture.
+
+#include "shared/rt64_smaa.h"
+
+[[vk::push_constant]] ConstantBuffer<SmaaCB> gConstants : register(b0);
+
+Texture2D<float4> gTexture0 : register(t1);
+Texture2D<float4> gTexture1 : register(t2);
+Texture2D<float4> gTexture2 : register(t3);
+SamplerState LinearSampler : register(s4);
+SamplerState PointSampler : register(s5);
+
+#if defined(FXAA_EXTREME)
+#   define EDGE_THRESHOLD 0.063
+#   define EDGE_THRESHOLD_MIN 0.0312
+#   define SEARCH_STEPS 24
+#   define SUBPIXEL 1.0
+#else
+#   define EDGE_THRESHOLD 0.125
+#   define EDGE_THRESHOLD_MIN 0.0625
+#   define SEARCH_STEPS 10
+#   define SUBPIXEL 0.75
+#endif
+
+float luma(float3 color) {
+    return dot(saturate(color), float3(0.299, 0.587, 0.114));
+}
+
+float lumaAt(float2 uv) {
+    return luma(gTexture0.SampleLevel(LinearSampler, uv, 0).rgb);
+}
+
+float lumaOffset(float2 uv, int2 offset) {
+    return luma(gTexture0.SampleLevel(PointSampler, uv, 0, offset).rgb);
+}
+
+// How far each search step moves, growing after the first few.
+float stepScale(int i) {
+    if (i < 4) {
+        return 1.0;
+    }
+    if (i < 8) {
+        return 1.5;
+    }
+    if (i < 12) {
+        return 2.0;
+    }
+    return 4.0;
+}
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    const float2 texel = gConstants.rtMetrics.xy;
+    const float4 center = gTexture0.SampleLevel(PointSampler, uv, 0);
+    const float lumaM = luma(center.rgb);
+    const float lumaN = lumaOffset(uv, int2(0, -1));
+    const float lumaS = lumaOffset(uv, int2(0, 1));
+    const float lumaW = lumaOffset(uv, int2(-1, 0));
+    const float lumaE = lumaOffset(uv, int2(1, 0));
+
+    const float lumaMax = max(lumaM, max(max(lumaN, lumaS), max(lumaW, lumaE)));
+    const float lumaMin = min(lumaM, min(min(lumaN, lumaS), min(lumaW, lumaE)));
+    const float range = lumaMax - lumaMin;
+    if (range < max(EDGE_THRESHOLD_MIN, lumaMax * EDGE_THRESHOLD)) {
+        return center;
+    }
+
+    const float lumaNW = lumaOffset(uv, int2(-1, -1));
+    const float lumaNE = lumaOffset(uv, int2(1, -1));
+    const float lumaSW = lumaOffset(uv, int2(-1, 1));
+    const float lumaSE = lumaOffset(uv, int2(1, 1));
+
+    // Horizontal or vertical edge, from the second differences across each axis.
+    const float edgeH = abs(lumaNW - 2.0 * lumaW + lumaSW) + 2.0 * abs(lumaN - 2.0 * lumaM + lumaS) + abs(lumaNE - 2.0 * lumaE + lumaSE);
+    const float edgeV = abs(lumaNW - 2.0 * lumaN + lumaNE) + 2.0 * abs(lumaW - 2.0 * lumaM + lumaE) + abs(lumaSW - 2.0 * lumaS + lumaSE);
+    const bool horizontal = edgeH >= edgeV;
+
+    // Which side of the pixel the edge lies on.
+    const float luma1 = horizontal ? lumaN : lumaW;
+    const float luma2 = horizontal ? lumaS : lumaE;
+    const float gradient1 = abs(luma1 - lumaM);
+    const float gradient2 = abs(luma2 - lumaM);
+    const bool side1 = gradient1 >= gradient2;
+    const float gradientScaled = 0.25 * max(gradient1, gradient2);
+    float stepLength = horizontal ? texel.y : texel.x;
+    float lumaLocal;
+    if (side1) {
+        stepLength = -stepLength;
+        lumaLocal = 0.5 * (luma1 + lumaM);
+    }
+    else {
+        lumaLocal = 0.5 * (luma2 + lumaM);
+    }
+
+    // Walk along the edge both ways until the luma along it changes.
+    float2 edgeUV = uv;
+    if (horizontal) {
+        edgeUV.y += stepLength * 0.5;
+    }
+    else {
+        edgeUV.x += stepLength * 0.5;
+    }
+
+    const float2 along = horizontal ? float2(texel.x, 0.0) : float2(0.0, texel.y);
+    float2 uv1 = edgeUV - along;
+    float2 uv2 = edgeUV + along;
+    float end1 = lumaAt(uv1) - lumaLocal;
+    float end2 = lumaAt(uv2) - lumaLocal;
+    bool reached1 = abs(end1) >= gradientScaled;
+    bool reached2 = abs(end2) >= gradientScaled;
+    [loop]
+    for (int i = 1; (i < SEARCH_STEPS) && !(reached1 && reached2); i++) {
+        if (!reached1) {
+            uv1 -= along * stepScale(i);
+            end1 = lumaAt(uv1) - lumaLocal;
+            reached1 = abs(end1) >= gradientScaled;
+        }
+
+        if (!reached2) {
+            uv2 += along * stepScale(i);
+            end2 = lumaAt(uv2) - lumaLocal;
+            reached2 = abs(end2) >= gradientScaled;
+        }
+    }
+
+    const float distance1 = horizontal ? (uv.x - uv1.x) : (uv.y - uv1.y);
+    const float distance2 = horizontal ? (uv2.x - uv.x) : (uv2.y - uv.y);
+    const bool nearer1 = distance1 < distance2;
+    const float distanceNear = min(distance1, distance2);
+    const float edgeLength = distance1 + distance2;
+    float offset = -distanceNear / edgeLength + 0.5;
+
+    // Only blend when the nearer end's luma moves the other way from the centre's.
+    const bool centerSmaller = (lumaM - lumaLocal) < 0.0;
+    const bool correct = ((nearer1 ? end1 : end2) < 0.0) != centerSmaller;
+    offset = correct ? offset : 0.0;
+
+    // Sub-pixel smoothing, for features smaller than a pixel.
+    const float lumaAverage = (2.0 * (lumaN + lumaS + lumaW + lumaE) + lumaNW + lumaNE + lumaSW + lumaSE) / 12.0;
+    const float subPixel1 = saturate(abs(lumaAverage - lumaM) / range);
+    const float subPixel2 = (-2.0 * subPixel1 + 3.0) * subPixel1 * subPixel1;
+    const float subPixelOffset = subPixel2 * subPixel2 * SUBPIXEL;
+    offset = max(offset, subPixelOffset);
+
+    float2 finalUV = uv;
+    if (horizontal) {
+        finalUV.y += offset * stepLength;
+    }
+    else {
+        finalUV.x += offset * stepLength;
+    }
+
+    return float4(gTexture0.SampleLevel(LinearSampler, finalUV, 0).rgb, center.a);
+}
diff --git a/src/shaders/Grass.hlsli b/src/shaders/Grass.hlsli
new file mode 100644
index 0000000..d52d51d
--- /dev/null
+++ b/src/shaders/Grass.hlsli
@@ -0,0 +1,171 @@
+//
+// RT64
+//
+
+// Banjo-Tooie: 3D grass, in the style of Breath of the Wild's fields. The level's ground draws are drawn
+// again as shells, each moved further up by its share of the blade height (RasterVS.hlsl); each shell keeps
+// only where a blade crosses it, so a stack of them reads as a field of blades. The blades grow in tufts,
+// one tuft per cell of a grid over the world's x and z: five thin, flat blades that arc out from the middle and
+// taper to a point. Wind waves roll across the field and bend them, and they are pushed down and away round
+// Banjo and along the trail he leaves, springing back up behind him. Dark at the roots, lighter and yellower
+// at the tips, and shorter with distance.
+
+#pragma once
+
+#include "FbRendererCommon.hlsli"
+
+static const uint GrassTrailPoints = 12;
+static const uint GrassTuftBlades = 5;
+
+// The world position at a pixel of a shell, from its depth, as SceneEffectsPS.hlsl works out view positions.
+float3 GrassWorldPosition(float4 pixelPosition) {
+    const float4 t = FrParams.grassDepthTerms;
+    const float ndcZ = pixelPosition.z * 2.0f - 1.0f;
+    const float z = (t.y - ndcZ * t.w) / (ndcZ * t.z - t.x);
+    const float4 p = FrParams.grassProjection;
+    const float2 ndc = float2(pixelPosition.x / p.z * 2.0f - 1.0f, 1.0f - pixelPosition.y / p.w * 2.0f);
+    const float3 view = float3(ndc.x * -z / p.x, ndc.y * -z / p.y, z);
+    return float3(
+        dot(view, FrParams.grassWorldX.xyz) + FrParams.grassWorldX.w,
+        dot(view, FrParams.grassWorldY.xyz) + FrParams.grassWorldY.w,
+        dot(view, FrParams.grassWorldZ.xyz) + FrParams.grassWorldZ.w);
+}
+
+float3 GrassHash(float2 cell) {
+    uint2 c = uint2(int2(cell) + 0x8000);
+    uint h = c.x * 0x8DA6B343u ^ c.y * 0xD8163841u;
+    h ^= h >> 13;
+    h *= 0x5BD1E995u;
+    h ^= h >> 15;
+    const uint h2 = h * 0x27D4EB2Du;
+    const uint h3 = h2 * 0x165667B1u;
+    return float3(h & 0xFFFF, h2 & 0xFFFF, h3 & 0xFFFF) / 65535.0f;
+}
+
+// Whether a shell's pixel at height share (0 to 1) is part of a blade; if so, shades it from root to tip.
+bool GrassShell(float3 world, float3 worldDx, float3 worldDy, float3 baseColor, float share, inout float3 color) {
+    // Green ground only (grass, not dirt, rock or paths).
+    if (!((baseColor.g - max(baseColor.r, baseColor.b) > 0.03f) && (baseColor.g > baseColor.b * 1.25f))) {
+        return false;
+    }
+
+    // Ground facing up: the shell lies parallel to it, so its slopes give the ground's normal.
+    const float3 normal = cross(worldDx, worldDy);
+    const float normalLength = length(normal);
+    if ((normalLength <= 0.0f) || (abs(normal.y) < 0.6f * normalLength)) {
+        return false;
+    }
+
+    // Shorter blades further away, gone by the fade distance.
+    const float4 params = FrParams.grassParams;
+    const float height = params.x;
+    const float3 camera = float3(FrParams.grassWorldX.w, FrParams.grassWorldY.w, FrParams.grassWorldZ.w);
+    const float cameraDistance = distance(world, camera);
+    const float fade = saturate(1.0f - cameraDistance / params.z);
+    // Further away the blades widen, so they don't thin to flickering lines.
+    const float widen = 1.0f + cameraDistance / 700.0f;
+    if (fade < 0.05f) {
+        return false;
+    }
+
+    // Wind: a slow wave rolling across the field along the wind, a faster cross wave, and a little flutter.
+    const float4 wind = FrParams.grassWind;
+    const float2 windDir = normalize(wind.xy);
+    const float2 windSide = float2(-windDir.y, windDir.x);
+    const float time = wind.z;
+    const float along = dot(world.xz, windDir);
+    const float across = dot(world.xz, windSide);
+    const float wave = 0.5f + 0.5f * sin(along * (6.2832f / 320.0f) - time * 1.9f + 0.8f * sin(across * (6.2832f / 900.0f)));
+    const float ripple = 0.5f + 0.5f * sin(dot(world.xz, float2(0.043f, -0.061f)) - time * 3.1f);
+    const float push = wave * wave * 0.75f + ripple * 0.25f;
+    float2 lean = windDir * height * wind.w * (0.08f + 0.42f * push);
+    lean += windSide * height * 0.05f * sin(time * 4.3f + along * 0.11f + across * 0.07f);
+
+    // Pressed down and away round Banjo and along his trail; older trail points spring back (and overshoot a little).
+    const float groundY = world.y - share * height;
+    const float radius = FrParams.grassPlayer.w;
+    float flatten = 0.0f;
+    float2 pushed = 0.0f;
+    const float4 bounds = FrParams.grassTrailBounds;
+    const bool nearTrail = all(world.xz >= bounds.xy) && all(world.xz <= bounds.zw);
+    for (uint i = 0; nearTrail && (i <= GrassTrailPoints); i++) {
+        const float4 trail = (i == GrassTrailPoints) ? float4(FrParams.grassPlayer.xyz, 1.0f) : FrParams.grassTrail[i];
+        if ((trail.w == 0.0f) || (trail.z < -1e8f) || (abs(groundY - trail.z) > 80.0f)) {
+            continue;
+        }
+
+        const float2 away = world.xz - trail.xy;
+        const float awayLength = length(away);
+        if (awayLength >= radius) {
+            continue;
+        }
+
+        const float k = 1.0f - awayLength / radius;
+        const float strength = trail.w * k * k * (3.0f - 2.0f * k);
+        pushed += (awayLength > 0.001f ? away / awayLength : windDir) * strength;
+        flatten = max(flatten, strength);
+    }
+
+    // Under Banjo the blades lie nearly flat; the wind matters less there.
+    lean = lerp(lean, 0.0f, saturate(flatten)) + pushed * height * 0.95f;
+    const float leanLength = length(lean);
+    if (leanLength > height * 0.95f) {
+        lean *= height * 0.95f / leanLength;
+    }
+
+    // A leaning blade's tip is lower, so the shells it reaches are fewer.
+    const float leanShare = min(leanLength / height, 0.95f);
+    const float tallness = fade * (1.0f - 0.55f * leanShare * leanShare) * (1.0f - 0.45f * saturate(flatten));
+
+    // The blades curve: the higher up, the further the shell's point is from the blade's root. Blades arc out
+    // of their tuft by up to half a cell. Tufts sit 0.2 to 0.8 of the way across their cell, so the four
+    // cells nearest the point hold every tuft that can reach it.
+    const float2 root = (world.xz - lean * pow(share, 1.5f)) * params.y;
+    const float2 first = floor(root - 0.5f);
+    const float reach = 0.5f * saturate(share * share / max(0.1f * tallness * tallness, 1e-4f)) + 0.15f * widen;
+    for (int c = 0; c < 4; c++) {
+        const float2 cell = first + float2(c & 1, c >> 1);
+        const float3 tuft = GrassHash(cell);
+        const float2 local = root - cell;
+        const float2 center = 0.2f + 0.6f * tuft.yz;
+        const float3 tuft2 = GrassHash(cell + 7919.0f);
+        const float tuftHeight = lerp(0.7f, 1.0f, tuft2.x) * tallness;
+        const float2 toCenter = local - center;
+        if ((tuft.x > params.w) || (share > tuftHeight) || (dot(toCenter, toCenter) > reach * reach)) {
+            continue;
+        }
+
+        // The blades fan out evenly round the tuft (a turn of a fifth each), each nudged a little.
+        float2 dir = float2(cos(tuft2.y * 6.2832f), sin(tuft2.y * 6.2832f));
+        for (uint b = 0; b < GrassTuftBlades; b++) {
+            dir = float2(dir.x * 0.309f - dir.y * 0.951f, dir.x * 0.951f + dir.y * 0.309f);
+            const float3 r = GrassHash(cell + float(b + 1) * 131.0f);
+            const float bladeHeight = tuftHeight * lerp(0.45f, 1.0f, r.z);
+            if (share > bladeHeight) {
+                continue;
+            }
+
+            // h runs from 0 at the root to 1 at the tip. The blade arcs out from the tuft's middle.
+            const float h = share / bladeHeight;
+            const float2 bladeDir = normalize(dir + (r.xy - 0.5f) * 0.6f);
+            const float2 d = toCenter - bladeDir * (0.05f * r.y + (0.12f + 0.33f * r.y) * h * h);
+
+            // Flat and wide across, thin through, tapering to a point.
+            const float halfWidth = (0.06f * pow(1.0f - h, 0.8f) + 0.01f) * widen;
+            const float halfThickness = 0.035f * widen;
+            if ((abs(dot(d, float2(-bladeDir.y, bladeDir.x))) > halfWidth) || (abs(dot(d, bladeDir)) > halfThickness)) {
+                continue;
+            }
+
+            // Dark at the roots, lighter and yellower at the tips; each blade a little different, and
+            // brighter where the wind lays the blades over.
+            float3 shade = color * lerp(0.4f, 1.05f, h) * lerp(0.85f, 1.12f, r.z);
+            shade = lerp(shade, shade * float3(1.3f, 1.22f, 0.65f) + float3(0.04f, 0.045f, 0.0f), h * h * 0.75f);
+            shade *= 1.0f + 0.16f * push * h * (1.0f - saturate(flatten));
+            color = shade;
+            return true;
+        }
+    }
+
+    return false;
+}
diff --git a/src/shaders/PhotoGradePS.hlsl b/src/shaders/PhotoGradePS.hlsl
new file mode 100644
index 0000000..0bbe1d5
--- /dev/null
+++ b/src/shaders/PhotoGradePS.hlsl
@@ -0,0 +1,217 @@
+//
+// RT64
+//
+
+// Banjo-Tooie: photo mode's filters on the finished game image, after SMAA and before the VI draws it,
+// so screenshots show them. A look (a fixed colour treatment) first, then exposure, contrast,
+// saturation, warmth, vignette and film grain. Then the crop frame (outside it shaded; screenshots keep
+// only the frame) and the rule-of-thirds grid inside it.
+
+#include "shared/rt64_photo_grade.h"
+
+#include "Depth.hlsli"
+
+[[vk::push_constant]] ConstantBuffer<PhotoGradeCB> gConstants : register(b0);
+
+Texture2D<float4> gTexture0 : register(t1);
+Texture2D<float4> gTexture1 : register(t2);
+Texture2D<float4> gTexture2 : register(t3);
+SamplerState LinearSampler : register(s4);
+SamplerState PointSampler : register(s5);
+
+float Luma(float3 rgb) {
+    return dot(rgb, float3(0.2126f, 0.7152f, 0.0722f));
+}
+
+float3 Saturation(float3 rgb, float amount) {
+    return lerp(Luma(rgb).xxx, rgb, amount);
+}
+
+float3 Contrast(float3 rgb, float amount) {
+    return (rgb - 0.5f) * amount + 0.5f;
+}
+
+float3 Look(float3 rgb, uint look) {
+    const float y = Luma(rgb);
+    if (look == 1) {
+        // Sepia.
+        return float3(dot(rgb, float3(0.393f, 0.769f, 0.189f)), dot(rgb, float3(0.349f, 0.686f, 0.168f)), dot(rgb, float3(0.272f, 0.534f, 0.131f)));
+    }
+    else if (look == 2) {
+        // Black and white.
+        return y.xxx;
+    }
+    else if (look == 3) {
+        // Noir: hard black and white.
+        return saturate(Contrast(y.xxx, 1.6f));
+    }
+    else if (look == 4) {
+        // Warm.
+        return rgb * float3(1.10f, 1.0f, 0.85f);
+    }
+    else if (look == 5) {
+        // Cool.
+        return rgb * float3(0.88f, 0.98f, 1.12f);
+    }
+    else if (look == 6) {
+        // Vivid.
+        return Contrast(Saturation(rgb, 1.45f), 1.1f);
+    }
+    else if (look == 7) {
+        // Faded film: lifted blacks, softer colour.
+        return lerp(float3(0.08f, 0.07f, 0.06f), float3(0.95f, 0.93f, 0.88f), Saturation(rgb, 0.7f));
+    }
+    else if (look == 8) {
+        // Teal and orange: shadows to teal, highlights to orange.
+        return saturate(rgb + lerp(float3(-0.05f, 0.03f, 0.06f), float3(0.07f, 0.02f, -0.06f), smoothstep(0.2f, 0.8f, y)));
+    }
+    else if (look == 9) {
+        // Dream: soft and bright, a little pink.
+        return lerp(rgb, float3(1.0f, 0.92f, 0.95f), 0.18f) * 1.05f;
+    }
+
+    return rgb;
+}
+
+// The scene's depth at a pixel: gTexture1 holds RT64's depth-to-color copy, an N64 16-bit depth value
+// packed as RGBA 5551. Returned as a distance (the game's near plane taken as 10 and far as 10000), so
+// blur grows evenly with how far something is from the focus.
+float SceneDistance(int2 pixel) {
+    const float4 c = gTexture1.Load(int3(pixel, 0));
+    const uint r = uint(round(saturate(c.r) * 255.0f)) >> 3;
+    const uint g = uint(round(saturate(c.g) * 255.0f)) >> 3;
+    const uint b = uint(round(saturate(c.b) * 255.0f)) >> 3;
+    const uint a = (c.a > 0.5f) ? 1u : 0u;
+    const float z = Depth16ToFloat((r << 11) | (g << 6) | (b << 1) | a);
+    const float n = 10.0f;
+    const float f = 10000.0f;
+    return (n * f) / max(f - z * (f - n), 1e-3f);
+}
+
+// Depth of field: the nearest thing in a small box at the middle of the picture is in focus, and the
+// picture blurs more the further a pixel's distance is from it (in either direction), up to a radius
+// set by the strength. A golden-angle spiral of taps gathers the blur.
+float3 DepthOfField(float2 uv, float3 sharp, int2 pixel) {
+    const float2 size = gConstants.rtMetrics.zw;
+    float focus = 1e9f;
+    [unroll] for (int y = -2; y <= 2; y++) {
+        [unroll] for (int x = -2; x <= 2; x++) {
+            focus = min(focus, SceneDistance(int2(size * 0.5f) + int2(x, y) * int(max(1.0f, size.y / 90.0f))));
+        }
+    }
+
+    const float distance = SceneDistance(pixel);
+    const float maxRadius = gConstants.dof.x * size.y / 60.0f;
+    const float coc = saturate(abs(distance - focus) / max(focus, 1.0f)) * maxRadius;
+    if (coc < 0.75f) {
+        return sharp;
+    }
+
+    const int taps = 32;
+    float3 sum = sharp;
+    float weight = 1.0f;
+    [loop] for (int i = 1; i <= taps; i++) {
+        const float t = float(i) / float(taps);
+        const float angle = float(i) * 2.39996323f;
+        const float2 offset = float2(cos(angle), sin(angle)) * sqrt(t) * coc;
+        const int2 tapPixel = clamp(pixel + int2(round(offset)), int2(0, 0), int2(size) - 1);
+        // A sharp thing in front of the focus doesn't bleed into the blurred background behind it.
+        const float tapDistance = SceneDistance(tapPixel);
+        const float tapCoc = saturate(abs(tapDistance - focus) / max(focus, 1.0f)) * maxRadius;
+        const float w = (tapDistance < distance) ? saturate(tapCoc / max(coc, 1e-3f)) : 1.0f;
+        sum += gTexture0.Load(int3(tapPixel, 0)).rgb * w;
+        weight += w;
+    }
+
+    return sum / weight;
+}
+
+// Contrast-adaptive sharpening: each pixel is pushed away from its four neighbours, less where the
+// neighbourhood already has strong contrast, so edges don't ring and flat areas don't gain noise.
+float3 Sharpen(int2 pixel, float3 center, float amount) {
+    const int2 maxPixel = int2(gConstants.rtMetrics.zw) - 1;
+    const float3 north = saturate(gTexture0.Load(int3(clamp(pixel + int2(0, -1), int2(0, 0), maxPixel), 0)).rgb);
+    const float3 south = saturate(gTexture0.Load(int3(clamp(pixel + int2(0, 1), int2(0, 0), maxPixel), 0)).rgb);
+    const float3 west = saturate(gTexture0.Load(int3(clamp(pixel + int2(-1, 0), int2(0, 0), maxPixel), 0)).rgb);
+    const float3 east = saturate(gTexture0.Load(int3(clamp(pixel + int2(1, 0), int2(0, 0), maxPixel), 0)).rgb);
+    const float3 c = saturate(center);
+    const float3 lowest = min(c, min(min(north, south), min(west, east)));
+    const float3 highest = max(c, max(max(north, south), max(west, east)));
+    const float3 room = sqrt(saturate(min(lowest, 1.0f - highest) / max(highest, 1e-4f)));
+    const float3 weight = -room * lerp(0.125f, 0.2f, amount);
+    return saturate((c + (north + south + west + east) * weight) / (1.0f + 4.0f * weight));
+}
+
+float Hash(float2 p) {
+    return frac(sin(dot(p, float2(12.9898f, 78.233f))) * 43758.5453f);
+}
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    float4 color = gTexture0.SampleLevel(PointSampler, uv, 0);
+    // F8 compare: the right half as it was, a line down the middle.
+    if (gConstants.frame.z > 0.5f) {
+        const float middle = gConstants.rtMetrics.z * 0.5f;
+        if (abs(pos.x - middle) < max(1.0f, gConstants.rtMetrics.w / 540.0f)) {
+            return float4(1.0f, 1.0f, 1.0f, color.a);
+        }
+        if (pos.x >= middle) {
+            return color;
+        }
+    }
+    if (gConstants.dof.w > 0.0f) {
+        color.rgb = Sharpen(int2(pos.xy), color.rgb, gConstants.dof.w);
+    }
+    if ((gConstants.dof.x > 0.0f) && (gConstants.dof.y > 0.5f)) {
+        color.rgb = DepthOfField(uv, color.rgb, int2(pos.xy));
+    }
+    float3 rgb = Look(saturate(color.rgb), uint(gConstants.effects.w + 0.5f));
+    rgb *= exp2(gConstants.tone.x);
+    rgb = Contrast(rgb, 1.0f + gConstants.tone.y);
+    rgb = Saturation(rgb, 1.0f + gConstants.tone.z);
+    rgb *= float3(1.0f + 0.12f * gConstants.tone.w, 1.0f, 1.0f - 0.12f * gConstants.tone.w);
+
+    // Vignette: darkens towards the corners.
+    const float2 centered = (uv - 0.5f) * float2(gConstants.rtMetrics.z / gConstants.rtMetrics.w, 1.0f);
+    rgb *= 1.0f - gConstants.effects.x * smoothstep(0.35f, 1.0f, length(centered) * 1.2f);
+
+    // Film grain: soft clumps sized to the picture (about two pixels at 1080p), so it reads the same at
+    // any resolution, strongest in the mid tones like real film.
+    const float grainSize = max(gConstants.rtMetrics.w / 540.0f, 1.0f);
+    const float2 grainAt = pos.xy / grainSize + frac(gConstants.effects.z) * 517.0f;
+    const float2 cell = floor(grainAt);
+    const float2 f = smoothstep(0.0f, 1.0f, grainAt - cell);
+    const float noise = lerp(lerp(Hash(cell), Hash(cell + float2(1.0f, 0.0f)), f.x),
+        lerp(Hash(cell + float2(0.0f, 1.0f)), Hash(cell + float2(1.0f, 1.0f)), f.x), f.y) - 0.5f;
+    const float midTones = 0.6f + 1.6f * Luma(rgb) * (1.0f - Luma(rgb));
+    rgb += noise * 0.3f * midTones * gConstants.effects.y;
+    rgb = saturate(rgb);
+
+    // The crop frame: the largest rectangle of that shape in the middle of the picture.
+    float2 frameMin = float2(0.0f, 0.0f);
+    float2 frameSize = gConstants.rtMetrics.zw;
+    const float cropAspect = gConstants.frame.x;
+    if (cropAspect > 0.0f) {
+        const float aspect = gConstants.rtMetrics.z / gConstants.rtMetrics.w;
+        frameSize = (cropAspect < aspect) ? float2(frameSize.y * cropAspect, frameSize.y) : float2(frameSize.x, frameSize.x / cropAspect);
+        frameMin = (gConstants.rtMetrics.zw - frameSize) * 0.5f;
+        if (any(pos.xy < frameMin) || any(pos.xy >= frameMin + frameSize)) {
+            rgb *= 0.3f;
+        }
+    }
+
+    // Rule-of-thirds grid: thin light lines at the thirds of the frame.
+    if (gConstants.frame.y > 0.5f) {
+        const float2 local = pos.xy - frameMin;
+        const float thickness = max(1.0f, gConstants.rtMetrics.w / 540.0f);
+        bool onLine = false;
+        [unroll] for (int i = 1; i <= 2; i++) {
+            const float2 at = frameSize * (float(i) / 3.0f);
+            onLine = onLine || (abs(local.x - at.x) < thickness * 0.5f) || (abs(local.y - at.y) < thickness * 0.5f);
+        }
+        if (onLine && all(local >= 0.0f) && all(local < frameSize)) {
+            rgb = lerp(rgb, float3(1.0f, 1.0f, 1.0f), 0.45f);
+        }
+    }
+
+    return float4(rgb, color.a);
+}
