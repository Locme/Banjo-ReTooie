+    // Banjo-Tooie: keeps or puts back a SnowGround's face corners (see SnowGround::corners).
+    static void snowGroundCorners(const DrawData &drawData, const std::vector<std::pair<uint32_t, uint32_t>> &faceRanges, uint32_t end, bool store,
