+    // from ground elsewhere (a bridge high above a meadow).
+    static constexpr uint32_t GrassGroundScale = 4;
+    static constexpr uint32_t GrassGroundCells = GrassMaskCells / GrassGroundScale;
+    static constexpr float GrassGroundNone = -1e30f;
+    // How close in height ground drawn over the grass has to be to it to keep blades off it.
+    static constexpr float GrassGroundReach = 40.0f;
