+    // Banjo-Tooie: FXAA on the finished game image, before the VI draws it (after SMAA when both are on).
+    // Mode: 0 off, 1 FXAA, 2 FXAA Extreme.
+    void SetFxaaMode(uint32_t mode);
+    uint32_t GetFxaaMode();
+
+    struct FxaaRenderer {
+        std::unique_ptr<RenderTexture> outputTexture;
+        std::unique_ptr<RenderFramebuffer> outputFramebuffer;
+        std::unique_ptr<SmaaDescriptorSet> descriptorSet;
+        uint32_t width = 0;
+        uint32_t height = 0;
+
+        // Records the pass and returns the smoothed image, or the input itself when FXAA is off or the
+        // image is in a format the pass wasn't made for.
+        RenderTexture *apply(RenderDevice *device, RenderCommandList *commandList, const ShaderLibrary *shaderLibrary,
+            RenderTexture *input, RenderFormat format, uint32_t width, uint32_t height);
+    };
+};
diff --git a/src/render/rt64_gpu_sections.h b/src/render/rt64_gpu_sections.h
new file mode 100644
index 0000000..3a996b9
--- /dev/null
+++ b/src/render/rt64_gpu_sections.h
@@ -0,0 +1,155 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <iterator>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "rt64_shader_library.h"
+
+namespace RT64 {
+    // Banjo-Tooie: the GPU time of each of the port's extra passes, for the frame rate overlay
+    // (lib/rt64 FrameStats::sectionMs). Each pass is bracketed by two timestamps in the command
+    // list that records it; once that command list has finished, collect() adds the times up.
+    enum class GpuSection : uint32_t {
+        WaterMask,
+        EyeAdaptation,
+        Bloom,
+        SceneEffects,
+        Smaa,
+        Fxaa,
+        PhotoFilters,
+        Fsr,
+        Output,
+        Interface,
+        Count
+    };
+
+    void RecordGpuSectionTime(GpuSection section, double ms);
+
+    // Whether anything reads the section times (the overlay in Full, a benchmark or TOOIE_FRAME_LOG).
+    // While nothing does, the timers write no timestamps and read nothing back (SetGpuSectionTiming).
+    bool GpuSectionTimingWanted();
+
+    struct GpuSectionTimer {
+        static constexpr uint32_t Capacity = 32;
+        std::unique_ptr<RenderQueryPool> pool;
+        struct Span {
+            GpuSection section;
+            uint32_t first;
+            bool counted;
+        };
+        std::vector<Span> spans;
+        RenderCommandList *commandList = nullptr;
+
+        // Call with the command list open, outside any render pass.
+        void begin(RenderDevice *device, RenderCommandList *list) {
+            spans.clear();
+            if (!GpuSectionTimingWanted()) {
+                commandList = nullptr;
+                return;
+            }
+            if (pool == nullptr) {
+                pool = device->createQueryPool(Capacity);
+            }
+            commandList = list;
+            commandList->resetQueryPool(pool.get(), 0, Capacity);
+        }
+
+        // Returns the span to pass to end(), or -1 when the pool is full, or when the pass is being
+        // recorded into some other command list than the one begin() was given.
+        int start(GpuSection section, const RenderCommandList *list) {
+            if ((commandList == nullptr) || (list != commandList) || ((spans.size() + 1) * 2 > Capacity)) {
+                return -1;
+            }
+            const uint32_t first = uint32_t(spans.size()) * 2;
+            commandList->writeTimestamp(pool.get(), first);
+            spans.push_back({ section, first, true });
+            return int(spans.size()) - 1;
+        }
+
+        void end(int span) {
+            if ((commandList != nullptr) && (span >= 0)) {
+                commandList->writeTimestamp(pool.get(), spans[span].first + 1);
+            }
+        }
+
+        // Leaves a span out of the totals: the pass turned out to be off and drew nothing.
+        void drop(int span) {
+            if (span >= 0) {
+                spans[span].counted = false;
+            }
+        }
+
+        // Call before the command list ends. Vulkan only reads back a pool whose every query was
+        // written, so the unused ones are written here too.
+        void finish() {
+            if (commandList == nullptr) {
+                return;
+            }
+            for (uint32_t i = uint32_t(spans.size()) * 2; i < Capacity; i++) {
+                commandList->writeTimestamp(pool.get(), i);
+            }
+            commandList = nullptr;
+        }
+
+        // Call once the command list has finished on the GPU.
+        void collect() {
+            if (spans.empty()) {
+                return;
+            }
+            pool->queryResults();
+            const uint64_t *results = pool->getResults();
+            for (const Span &span : spans) {
+                const uint64_t a = results[span.first];
+                const uint64_t b = results[span.first + 1];
+                if (span.counted && (b >= a)) {
+                    RecordGpuSectionTime(span.section, double(b - a) / 1000000.0);
+                }
+            }
+            spans.clear();
+        }
+    };
+
+    // The timer for the workload command list (the game's frame and the scene effects).
+    GpuSectionTimer &WorkloadGpuSections();
+
+    // Banjo-Tooie: marks a point in a command list that the driver follows on the GPU, so a lost device
+    // (the GPU stopped answering) reports the last pass the GPU started and finished (plume::DeviceLostReport).
+    // Always on, timed or not. The marker must be a string literal.
+    inline void GpuCheckpoint(const RenderCommandList *list, const char *marker) {
+        if (list != nullptr) {
+            const_cast<RenderCommandList *>(list)->setCheckpoint(marker);
+        }
+    }
+
+    inline const char *GpuSectionMarker(GpuSection section, bool end) {
+        static const char *starts[] = { "water mask: start", "eye adaptation: start", "bloom: start", "scene effects: start",
+            "SMAA: start", "FXAA: start", "photo filters: start", "FSR: start", "output: start", "interface: start" };
+        static const char *ends[] = { "water mask: end", "eye adaptation: end", "bloom: end", "scene effects: end",
+            "SMAA: end", "FXAA: end", "photo filters: end", "FSR: end", "output: end", "interface: end" };
+        static_assert(std::size(starts) == size_t(GpuSection::Count), "one marker per section");
+        return end ? ends[uint32_t(section)] : starts[uint32_t(section)];
+    }
+
+    // Starts a span on construction and ends it on destruction, with a checkpoint at each end.
+    struct GpuSectionScope {
+        GpuSectionTimer &timer;
+        int span;
+        const RenderCommandList *list;
+        GpuSection section;
+        GpuSectionScope(GpuSectionTimer &timer, GpuSection section, const RenderCommandList *list) : timer(timer), list(list), section(section) {
+            GpuCheckpoint(list, GpuSectionMarker(section, false));
+            span = timer.start(section, list);
+        }
+        void drop() { timer.drop(span); }
+        ~GpuSectionScope() {
+            timer.end(span);
+            GpuCheckpoint(list, GpuSectionMarker(section, true));
+        }
+    };
+};
diff --git a/src/render/rt64_photo_grade.cpp b/src/render/rt64_photo_grade.cpp
new file mode 100644
index 0000000..ae4ef06
--- /dev/null
+++ b/src/render/rt64_photo_grade.cpp
@@ -0,0 +1,144 @@
+//
+// RT64
+//
+
+#include "rt64_photo_grade.h"
+
+#include <chrono>
+#include <mutex>
+
+#include "shared/rt64_photo_grade.h"
+
+#include "rt64_render_target.h"
+
+namespace RT64 {
+    namespace {
+        std::mutex gradeMutex;
+        PhotoGradeSettings gradeSettings;
+        const auto startTime = std::chrono::steady_clock::now();
+    }
+
+    void SetPhotoGrade(bool enabled, uint32_t look, float exposure, float contrast, float saturation, float warmth, float vignette, float grain) {
+        const std::scoped_lock lock(gradeMutex);
+        const float cropAspect = gradeSettings.cropAspect;
+        const bool grid = gradeSettings.grid;
+        const uint32_t border = gradeSettings.border;
+        const float dofStrength = gradeSettings.dofStrength;
+        const uint32_t depthAddress = gradeSettings.depthAddress;
+        const float focusX = gradeSettings.focusX;
+        const float focusY = gradeSettings.focusY;
+        const float sharpen = gradeSettings.sharpen;
+        gradeSettings = { enabled, look, exposure, contrast, saturation, warmth, vignette, grain, cropAspect, grid, border, dofStrength, depthAddress, focusX, focusY, sharpen };
+    }
+
+    void SetSharpening(float strength) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.sharpen = strength;
+    }
+
+    void SetPhotoDepthOfField(float strength, uint32_t depthAddress) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.dofStrength = strength;
+        gradeSettings.depthAddress = depthAddress;
+    }
+
+    void SetPhotoFocus(float x, float y) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.focusX = x;
+        gradeSettings.focusY = y;
+    }
+
+    PhotoGradeSettings GetPhotoGrade() {
+        const std::scoped_lock lock(gradeMutex);
+        return gradeSettings;
+    }
+
+    void SetPhotoGradeCompare(bool compare) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.compare = compare;
+    }
+
+    void SetPhotoFrame(float cropAspect, bool grid) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.cropAspect = cropAspect;
+        gradeSettings.grid = grid;
+    }
+
+    void SetPhotoBorder(uint32_t border) {
+        const std::scoped_lock lock(gradeMutex);
+        gradeSettings.border = border;
+    }
+
+    RenderTexture *PhotoGradeRenderer::apply(RenderDevice *device, RenderCommandList *commandList, const ShaderLibrary *shaderLibrary,
+        RenderTexture *input, RenderFormat format, uint32_t width, uint32_t height, bool forScreenshot, RenderTexture *depth)
+    {
+        PhotoGradeSettings settings;
+        {
+            const std::scoped_lock lock(gradeMutex);
+            settings = gradeSettings;
+        }
+
+        if (!settings.enabled) {
+            // Only the sharpening, if that.
+            const float sharpen = settings.sharpen;
+            const bool compare = settings.compare;
+            settings = PhotoGradeSettings();
+            settings.sharpen = sharpen;
+            settings.compare = compare;
+            if (sharpen <= 0.0f) {
+                return input;
+            }
+        }
+
+        if ((input == nullptr) || (width == 0) || (height == 0) || (format != RenderTarget::colorBufferFormat(shaderLibrary->usesHDR))) {
+            return input;
+        }
+
+        if ((this->width != width) || (this->height != height) || (outputTexture == nullptr)) {
+            outputFramebuffer.reset();
+            outputTexture = device->createTexture(RenderTextureDesc::ColorTarget(width, height, format));
+            outputTexture->setName("Photo Grade Output");
+            const RenderTexture *output = outputTexture.get();
+            outputFramebuffer = device->createFramebuffer(RenderFramebufferDesc(&output, 1));
+            this->width = width;
+            this->height = height;
+        }
+
+        if (descriptorSet == nullptr) {
+            descriptorSet = std::make_unique<SmaaDescriptorSet>(shaderLibrary->samplerLibrary.linear.clampClamp.get(),
+                shaderLibrary->samplerLibrary.nearest.clampClamp.get(), device);
+        }
+
+        // Every slot gets a texture; the pass reads the first, and the second for depth of field.
+        descriptorSet->setTexture(descriptorSet->gTexture0, input, RenderTextureLayout::SHADER_READ);
+        descriptorSet->setTexture(descriptorSet->gTexture1, (depth != nullptr) ? depth : input, RenderTextureLayout::SHADER_READ);
+        descriptorSet->setTexture(descriptorSet->gTexture2, input, RenderTextureLayout::SHADER_READ);
+
+        interop::PhotoGradeCB constants;
+        constants.rtMetrics = { 1.0f / float(width), 1.0f / float(height), float(width), float(height) };
+        constants.tone = { settings.exposure, settings.contrast, settings.saturation, settings.warmth };
+        const float seconds = std::chrono::duration<float>(std::chrono::steady_clock::now() - startTime).count();
+        constants.effects = { settings.vignette, settings.grain, seconds, float(settings.look) };
+        constants.frame = { settings.cropAspect, (settings.grid && !forScreenshot) ? 1.0f : 0.0f, settings.compare ? 1.0f : 0.0f, float(settings.border) };
+        constants.dof = { settings.dofStrength, (depth != nullptr) ? 1.0f : 0.0f, shaderLibrary->usesHDR ? 1.0f : 0.0f, settings.sharpen };
+        constants.focus = { settings.focusX, settings.focusY, 0.0f, 0.0f };
+
+        RenderTextureBarrier barriers[] = {
+            RenderTextureBarrier(input, RenderTextureLayout::SHADER_READ),
+            RenderTextureBarrier(outputTexture.get(), RenderTextureLayout::COLOR_WRITE),
+            RenderTextureBarrier((depth != nullptr) ? depth : input, RenderTextureLayout::SHADER_READ)
+        };
+
+        commandList->barriers(RenderBarrierStage::GRAPHICS, barriers, uint32_t(std::size(barriers)));
+        commandList->setFramebuffer(outputFramebuffer.get());
+        commandList->setPipeline(shaderLibrary->photoGrade.pipeline.get());
+        commandList->setGraphicsPipelineLayout(shaderLibrary->photoGrade.pipelineLayout.get());
+        commandList->setGraphicsDescriptorSet(descriptorSet->get(), 0);
+        commandList->setGraphicsPushConstants(0, &constants);
+        commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        commandList->setViewports(RenderViewport(0.0f, 0.0f, float(width), float(height)));
+        commandList->setScissors(RenderRect(0, 0, width, height));
+        commandList->drawInstanced(3, 1, 0, 0);
+        return outputTexture.get();
+    }
+};
diff --git a/src/render/rt64_photo_grade.h b/src/render/rt64_photo_grade.h
new file mode 100644
index 0000000..2df8ab2
--- /dev/null
+++ b/src/render/rt64_photo_grade.h
@@ -0,0 +1,70 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include "rt64_descriptor_sets.h"
+#include "rt64_shader_library.h"
+
+namespace RT64 {
+    // Banjo-Tooie: photo mode's filters, drawn over the game image after SMAA and before the VI (so
+    // screenshots show them). Everything at 0 and enabled false leaves the picture alone.
+    struct PhotoGradeSettings {
+        bool enabled = false;
+        uint32_t look = 0;
+        float exposure = 0.0f;
+        float contrast = 0.0f;
+        float saturation = 0.0f;
+        float warmth = 0.0f;
+        float vignette = 0.0f;
+        float grain = 0.0f;
+        float cropAspect = 0.0f;
+        bool grid = false;
+        uint32_t border = 0;
+        float dofStrength = 0.0f;
+        uint32_t depthAddress = 0;
+        float focusX = 0.5f;
+        float focusY = 0.5f;
+        float sharpen = 0.0f;
+        bool compare = false;
+    };
+
+    void SetPhotoGrade(bool enabled, uint32_t look, float exposure, float contrast, float saturation, float warmth, float vignette, float grain);
+
+    // The crop frame (width / height, 0 for none; outside it is shaded) and the rule-of-thirds grid.
+    // The grid is left out of the frame a screenshot is taken from.
+    void SetPhotoFrame(float cropAspect, bool grid);
+    // A border drawn over the edge of the crop frame and kept in screenshots: 0 none, 1 instant photo, 2 film
+    // strip, 3 honeycomb, 4 Jiggy, 5 wooden.
+    void SetPhotoBorder(uint32_t border);
+
+    // Depth of field (0 off, 1 strongest), focused on the nearest thing at the middle of the picture.
+    // depthAddress is the game's depth buffer in RDRAM, whose render target gives the scene's depth.
+    void SetPhotoDepthOfField(float strength, uint32_t depthAddress);
+    // Where depth of field focuses, as a fraction of the picture (0.5, 0.5 is the middle, the default).
+    void SetPhotoFocus(float x, float y);
+    // Sharpening (0 off, 1 strongest), a contrast-adaptive sharpen drawn in the same pass. It is kept
+    // apart from the filters above, which photo mode and the game's picture settings take turns to set.
+    void SetSharpening(float strength);
+    // Banjo-Tooie F8: the filters only on the left half of the picture, with a line down the middle.
+    void SetPhotoGradeCompare(bool compare);
+
+    // The depth of field strength and depth buffer address last set (strength 0 while photo mode is off).
+    PhotoGradeSettings GetPhotoGrade();
+
+    struct PhotoGradeRenderer {
+        std::unique_ptr<RenderTexture> outputTexture;
+        std::unique_ptr<RenderFramebuffer> outputFramebuffer;
+        std::unique_ptr<SmaaDescriptorSet> descriptorSet;
+        uint32_t width = 0;
+        uint32_t height = 0;
+
+        // Records the pass and returns the graded image, or the input itself when the filters are off.
+        // forScreenshot leaves the grid out.
+        // depth, when not null, holds the scene's depth as RT64's depth-to-color copy writes it (an RGBA16
+        // depth value per pixel) at the input's size.
+        RenderTexture *apply(RenderDevice *device, RenderCommandList *commandList, const ShaderLibrary *shaderLibrary,
+            RenderTexture *input, RenderFormat format, uint32_t width, uint32_t height, bool forScreenshot, RenderTexture *depth);
+    };
+};
