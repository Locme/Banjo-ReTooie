--- a/recompinput/src/input_types.cpp
+++ b/recompinput/src/input_types.cpp
@@ -81,6 +81,30 @@ bool get_game_input_is_menu(GameInput input) {
 #undef DEFINE_INPUT
 }
 
+static std::unordered_map<GameInput, std::string> game_input_sections = {};
+
+const std::string& get_game_input_section(GameInput input) {
+    static const std::string default_section = "Hotkeys";
+    auto it = game_input_sections.find(input);
+    return it == game_input_sections.end() ? default_section : it->second;
+}
+
+void set_game_input_section(GameInput input, const std::string& section) {
+    game_input_sections[input] = section;
+}
+
+bool get_game_input_is_hotkey(GameInput input) {
+#define DEFINE_INPUT(name, value, readable) case GameInput::name: return true;
+
+    switch (input) {
+        DEFINE_GAME_HOTKEY_INPUTS()
+    default:
+        return false;
+    }
+
+#undef DEFINE_INPUT
+}
+
 const std::string& get_game_input_enum_name(GameInput input) {
     return game_input_enum_names.at(static_cast<size_t>(input));
 }
