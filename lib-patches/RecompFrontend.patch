+    } else {
+        body->set_width(100.0f, Unit::Percent);
+    }
+
+    // Controller and arrow keys (L, 2026-10-16): up and down the sidebar opens each tab, A or Right moves into
+    // the page, B goes back to the sidebar. Inside a page the stick stays in the page, and inside the sidebar
