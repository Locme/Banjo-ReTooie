         if (recompinput::get_game_input_is_menu(input)) {
             game_input_sections.menu.contexts.push_back(input_ctx);
+        } else if (recompinput::get_game_input_is_hotkey(input)) {
+            // Hotkeys are grouped by their section name; "Hotkeys" (the default) comes first.
+            const std::string& section_name = recompinput::get_game_input_section(input);
+            if (game_input_sections.other.empty()) {
+                game_input_sections.other.emplace_back("Hotkeys");
+            }
+            GameInputSection* section = nullptr;
+            for (auto& existing : game_input_sections.other) {
+                if (existing.name == section_name) {
+                    section = &existing;
+                }
+            }
+            if (section == nullptr) {
+                section = &game_input_sections.other.emplace_back(section_name);
+            }
+            section->contexts.push_back(input_ctx);
         } else {
             game_input_sections.n64.contexts.push_back(input_ctx);
         }
