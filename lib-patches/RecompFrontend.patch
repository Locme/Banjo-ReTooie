+static std::mutex game_mouse_mutex;
+static int game_mouse_pos[4] = { -1, -1, 0, 0 };   // x, y, window width, height
+static std::atomic_uint32_t game_mouse_moves = 0;
+static std::atomic_uint32_t game_mouse_clicks[8] = {};
