+
+static void note_game_mouse_position(Uint32 window_id, int x, int y) {
+    SDL_Window* window = SDL_GetWindowFromID(window_id);
+    int w = 0;
+    int h = 0;
+    if (window != nullptr) {
+        SDL_GetWindowSize(window, &w, &h);
+    }
+    if (w > 0 && h > 0) {
+        std::lock_guard lock{ game_mouse_mutex };
+        game_mouse_pos[0] = x;
+        game_mouse_pos[1] = y;
+        game_mouse_pos[2] = w;
+        game_mouse_pos[3] = h;
+    }
+}
+
+bool get_game_mouse_position(int* x, int* y, int* w, int* h) {
+    std::lock_guard lock{ game_mouse_mutex };
+    *x = game_mouse_pos[0];
+    *y = game_mouse_pos[1];
+    *w = game_mouse_pos[2];
+    *h = game_mouse_pos[3];
+    return *w > 0;
+}
+
+uint32_t get_game_mouse_moves() {
+    return game_mouse_moves.load();
+}
+
+int32_t get_game_mouse_wheel() {
+    return game_mouse_wheel.load();
+}
+
+uint32_t get_game_mouse_clicks(int button) {
+    return (button >= 0 && button < 8) ? game_mouse_clicks[button].load() : 0;
+}
