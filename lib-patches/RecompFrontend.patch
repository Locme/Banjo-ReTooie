diff --git a/recompinput/src/extra_buttons.cpp b/recompinput/src/extra_buttons.cpp
new file mode 100644
index 0000000..0ea95f1
--- /dev/null
+++ b/recompinput/src/extra_buttons.cpp
@@ -0,0 +1,93 @@
+#include <cstdio>
+#include <iterator>
+
+#include "recompinput/extra_buttons.h"
+
+// Buttons a pad's back buttons can stand in for, in order, when SDL's mapping
+// doesn't report them itself.
+static constexpr SDL_GameControllerButton extra_buttons[] = {
+    SDL_CONTROLLER_BUTTON_PADDLE1,
+    SDL_CONTROLLER_BUTTON_PADDLE2,
+    SDL_CONTROLLER_BUTTON_PADDLE3,
+    SDL_CONTROLLER_BUTTON_PADDLE4,
+    SDL_CONTROLLER_BUTTON_MISC1,
+};
+
+static bool raw_button_is_mapped(SDL_GameController* controller, int raw_button) {
+    for (int b = 0; b < SDL_CONTROLLER_BUTTON_MAX; b++) {
+        SDL_GameControllerButtonBind bind = SDL_GameControllerGetBindForButton(controller, (SDL_GameControllerButton)b);
+        if (bind.bindType == SDL_CONTROLLER_BINDTYPE_BUTTON && bind.value.button == raw_button) {
+            return true;
+        }
+    }
+    for (int a = 0; a < SDL_CONTROLLER_AXIS_MAX; a++) {
+        SDL_GameControllerButtonBind bind = SDL_GameControllerGetBindForAxis(controller, (SDL_GameControllerAxis)a);
+        if (bind.bindType == SDL_CONTROLLER_BINDTYPE_BUTTON && bind.value.button == raw_button) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Pairs the pad's unmapped raw buttons, in order, with the extra buttons its
+// mapping doesn't have. Returns the raw button standing in for `button`, or -1.
+static int raw_button_for_extra_button(SDL_GameController* controller, SDL_GameControllerButton button) {
+    SDL_Joystick* joystick = SDL_GameControllerGetJoystick(controller);
+    int num_raw = joystick != nullptr ? SDL_JoystickNumButtons(joystick) : 0;
+    size_t slot = 0;
+    for (int raw = 0; raw < num_raw; raw++) {
+        if (raw_button_is_mapped(controller, raw)) {
+            continue;
+        }
+        while (slot < std::size(extra_buttons) && SDL_GameControllerHasButton(controller, extra_buttons[slot])) {
+            slot++;
+        }
+        if (slot >= std::size(extra_buttons)) {
+            return -1;
+        }
+        if (extra_buttons[slot] == button) {
+            return raw;
+        }
+        slot++;
+    }
+    return -1;
+}
+
+int recompinput::extra_button_for_raw_button(SDL_GameController* controller, int raw_button) {
+    for (SDL_GameControllerButton button : extra_buttons) {
+        if (!SDL_GameControllerHasButton(controller, button) && raw_button_for_extra_button(controller, button) == raw_button) {
+            return button;
+        }
+    }
+    return -1;
+}
+
+bool recompinput::get_controller_button(SDL_GameController* controller, SDL_GameControllerButton button) {
+    if (SDL_GameControllerGetButton(controller, button)) {
+        return true;
+    }
+    if (!SDL_GameControllerHasButton(controller, button)) {
+        int raw = raw_button_for_extra_button(controller, button);
+        if (raw >= 0) {
+            return SDL_JoystickGetButton(SDL_GameControllerGetJoystick(controller), raw) != 0;
+        }
+    }
+    return false;
+}
+
+void recompinput::log_controller_buttons(SDL_GameController* controller) {
+    SDL_Joystick* joystick = SDL_GameControllerGetJoystick(controller);
+    printf("  Name: %s, type %d, %d raw buttons\n", SDL_GameControllerName(controller),
+        (int)SDL_GameControllerGetType(controller), joystick != nullptr ? SDL_JoystickNumButtons(joystick) : 0);
+    for (SDL_GameControllerButton button : extra_buttons) {
+        if (SDL_GameControllerHasButton(controller, button)) {
+            printf("  Reports %s\n", SDL_GameControllerGetStringForButton(button));
+        }
+        else {
+            int raw = raw_button_for_extra_button(controller, button);
+            if (raw >= 0) {
+                printf("  Raw button %d stands in for %s\n", raw, SDL_GameControllerGetStringForButton(button));
+            }
+        }
+    }
+}
