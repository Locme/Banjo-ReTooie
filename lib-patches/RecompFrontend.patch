+        choice_callback = on_change;
+        if (choice_box == nullptr) {
+            auto context = get_current_context();
+            choice_box = context.create_element<Element>(this);
+            choice_box->set_display(Display::Flex);
+            choice_box->set_align_items(AlignItems::Center);
+            choice_box->set_margin_left(24.0f);
+            choice_box->set_gap(10.0f);
+            choice_box->set_color(theme::color::Primary);
+            choice_left = context.create_element<Label>(choice_box, "<", theme::Typography::LabelLG);
+            choice_label = context.create_element<Label>(choice_box, "", theme::Typography::LabelLG);
+            choice_right = context.create_element<Label>(choice_box, ">", theme::Typography::LabelLG);
+            choice_left->set_padding_left(8.0f);
+            choice_left->set_padding_right(8.0f);
+            choice_right->set_padding_left(8.0f);
+            choice_right->set_padding_right(8.0f);
+        }
+        choice_box->set_display(names.empty() ? Display::None : Display::Flex);
+        if (!names.empty()) {
+            choice_label->set_text(names[choice]);
+        }
+    }
+
+    void GameOption::step_choice(int direction) {
+        if (choices.empty()) {
+            return;
+        }
+        const size_t count = choices.size();
+        choice = (choice + count + (direction < 0 ? count - 1 : 1)) % count;
+        choice_label->set_text(choices[choice]);
+        if (choice_callback) {
+            choice_callback(choice);
+        }
+    }
+
+    bool GameOption::hit(Element *element, float x, float y) {
+        if (element == nullptr) {
+            return false;
+        }
+        const float left = element->get_absolute_left();
+        const float top = element->get_absolute_top();
+        return x >= left && x <= left + element->get_client_width() && y >= top && y <= top + element->get_client_height();
+    }
 }
