diff --git a/recompui/src/config/ui_config_page_controls.cpp b/recompui/src/config/ui_config_page_controls.cpp
index f379a6f..b82e81c 100644
--- a/recompui/src/config/ui_config_page_controls.cpp
+++ b/recompui/src/config/ui_config_page_controls.cpp
@@ -206,6 +206,11 @@ void ConfigPageControls::create_game_input_contexts() {
 
         if (recompinput::get_game_input_is_menu(input)) {
             game_input_sections.menu.contexts.push_back(input_ctx);
+        } else if (recompinput::get_game_input_is_hotkey(input)) {
+            if (game_input_sections.other.empty()) {
+                game_input_sections.other.emplace_back("Hotkeys");
+            }
+            game_input_sections.other.front().contexts.push_back(input_ctx);
         } else {
             game_input_sections.n64.contexts.push_back(input_ctx);
         }
