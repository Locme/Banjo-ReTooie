+        const float bottom = top + option->get_client_height();
+        const float scroll = box.get_scroll_top();
+        if (top - margin < scroll) {
+            box.set_scroll_top(std::max(0.0f, top - margin));
+        } else if (bottom + margin > scroll + view) {
+            box.set_scroll_top(bottom + margin - view);
+        }
