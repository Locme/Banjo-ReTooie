+            auto *list = context.create_element<Container>(scroll, FlexDirection::Column, JustifyContent::FlexStart);
+            list->set_gap(8.0f);
+
+            // One hidden row for every option of every other tab; searching only shows and hides them.
+            struct Row {
+                Container *box;
+                ConfigOptionElement *element;
+                recomp::config::Config *config;
