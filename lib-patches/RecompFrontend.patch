+                    recomp::config::Config &c = config::get_config(tab_id);
+                    c.set_option_value(option_id, value);
+                    if (c.requires_confirmation && tab_id == config::graphics::id) {
+                        c.save_config();
+                    }
+                };
+                auto no_hover = [](const std::string &) {};
+                auto schema = cfg->get_config_schema();
+                for (size_t i = 0; i < schema.options.size(); i++) {
+                    const auto &option = schema.options[i];
+                    auto *box = context.create_element<Container>(list, FlexDirection::Column, JustifyContent::FlexStart);
+                    box->set_display(Display::None);
+                    context.create_element<Label>(box, cfg->name + " tab", LabelStyle::Annotation);
+                    ConfigOptionElement *element = nullptr;
+                    switch (option.type) {
+                        case recomp::config::ConfigOptionType::Enum:
+                            element = context.create_element<ConfigOptionEnum>(box, option.id, i, cfg, set_value, no_hover);
+                            break;
+                        case recomp::config::ConfigOptionType::Number:
+                            element = context.create_element<ConfigOptionNumber>(box, option.id, i, cfg, set_value, no_hover);
+                            break;
+                        case recomp::config::ConfigOptionType::String:
+                            element = context.create_element<ConfigOptionString>(box, option.id, i, cfg, set_value, no_hover);
