+		for (int i = 0; i < width * height; i++)
+			filled[i] = data[i * 4 + 3] != 0;
+		for (int pass = 0; pass < 2; pass++)
+		{
+			Vector<byte> next = filled;
+			for (int y = 0; y < height; y++)
+			{
+				for (int x = 0; x < width; x++)
+				{
+					const int i = y * width + x;
+					if (filled[i])
+						continue;
+					int from = -1;
+					if (x > 0 && filled[i - 1])
+						from = i - 1;
+					else if (x + 1 < width && filled[i + 1])
+						from = i + 1;
+					else if (y > 0 && filled[i - width])
+						from = i - width;
+					else if (y + 1 < height && filled[i + width])
+						from = i + width;
+					if (from >= 0)
+					{
+						data[i * 4 + 0] = data[from * 4 + 0];
+						data[i * 4 + 1] = data[from * 4 + 1];
+						data[i * 4 + 2] = data[from * 4 + 2];
+						next[i] = 1;
+					}
+				}
+			}
+			filled.swap(next);
+		}
+	}
