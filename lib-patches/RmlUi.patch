diff --git a/Source/Core/RenderInterfaceCompatibility.cpp b/Source/Core/RenderInterfaceCompatibility.cpp
index eb973875..3455b6b6 100644
--- a/Source/Core/RenderInterfaceCompatibility.cpp
+++ b/Source/Core/RenderInterfaceCompatibility.cpp
@@ -198,6 +198,49 @@ TextureHandle RenderInterfaceAdapter::GenerateTexture(Span<const byte> source_da
 		UnPremultiplyAlpha(&source_data[i], unpremultiplied_copy.get() + i);
 	}
 
+	// Banjo Re-Tooie: a clear pixel comes out white from UnPremultiplyAlpha, and the renderer's linear filter blends it
+	// into the edge of whatever it borders, which drew a white outline round the start menu's art whenever a layer moved
+	// by part of a pixel (L, 2026-11-03). Clear pixels take the colour of a neighbour that isn't clear instead, two
+	// pixels out from the art, so the filter only ever mixes in the edge's own colour.
+	{
+		const int width = source_dimensions.x;
+		const int height = source_dimensions.y;
+		byte* data = unpremultiplied_copy.get();
+		Vector<byte> filled(size_t(width) * size_t(height));
+		for (int i = 0; i < width * height; i++)
+			filled[i] = data[i * 4 + 3] != 0;
+		for (int pass = 0; pass < 2; pass++)
+		{
+			Vector<byte> next = filled;
+			for (int y = 0; y < height; y++)
+			{
+				for (int x = 0; x < width; x++)
+				{
+					const int i = y * width + x;
+					if (filled[i])
+						continue;
+					int from = -1;
+					if (x > 0 && filled[i - 1])
+						from = i - 1;
+					else if (x + 1 < width && filled[i + 1])
+						from = i + 1;
+					else if (y > 0 && filled[i - width])
+						from = i - width;
+					else if (y + 1 < height && filled[i + width])
+						from = i + width;
+					if (from >= 0)
+					{
+						data[i * 4 + 0] = data[from * 4 + 0];
+						data[i * 4 + 1] = data[from * 4 + 1];
+						data[i * 4 + 2] = data[from * 4 + 2];
+						next[i] = 1;
+					}
+				}
+			}
+			filled.swap(next);
+		}
+	}
+
 	TextureHandle texture_handle = {};
 	if (!legacy.GenerateTexture(texture_handle, unpremultiplied_copy.get(), source_dimensions))
 		texture_handle = {};
