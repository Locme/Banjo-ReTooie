+    }
+
+    // Big textures keep their size in the label (one group per size), small ones are grouped by name alone.
+    static std::string TextureMemoryLabel(const std::string &name, const RenderTextureDesc &desc, uint64_t bytes) {
+        std::string label = name;
+        if (label.empty()) {
+            if (desc.flags & RenderTextureFlag::DEPTH_TARGET) {
+                label = "unnamed depth target";
+            }
+            else if (desc.flags & RenderTextureFlag::RENDER_TARGET) {
+                label = "unnamed render target";
+            }
+            else if (desc.flags & RenderTextureFlag::STORAGE) {
+                label = "unnamed storage texture";
+            }
+            else {
+                label = "unnamed texture";
+            }
+        }
+
+        if (bytes >= (8ULL << 20)) {
+            label += " " + std::to_string(desc.width) + "x" + std::to_string(desc.height);
+        }
+
+        if (desc.multisampling.sampleCount > 1) {
+            label += " MSAA " + std::to_string(desc.multisampling.sampleCount) + "x";
+        }
+
+        return label;
+    }
+
+    static std::string BufferMemoryLabel(const std::string &name, const RenderBufferDesc &desc) {
+        std::string label = name;
+        if (label.empty()) {
+            if (desc.flags & RenderBufferFlag::VERTEX) {
+                label = "unnamed vertex buffer";
+            }
+            else if (desc.flags & RenderBufferFlag::INDEX) {
+                label = "unnamed index buffer";
+            }
+            else if (desc.flags & RenderBufferFlag::CONSTANT) {
+                label = "unnamed constant buffer";
+            }
+            else if (desc.flags & RenderBufferFlag::STORAGE) {
+                label = "unnamed storage buffer";
+            }
+            else {
+                label = "unnamed buffer";
+            }
+        }
+
+        switch (desc.heapType) {
+        case RenderHeapType::UPLOAD:
+            label += " (upload, system RAM)";
+            break;
+        case RenderHeapType::READBACK:
+            label += " (read-back, system RAM)";
+            break;
+        default:
+            break;
+        }
