+
+    const char *GetVulkanObjectName(int kind) {
+        return VulkanObjectNames[kind];
+    }
+
+    void GetVulkanObjectCount(int kind, int64_t &live, int64_t &made) {
+        live = VulkanObjectsLive[kind].load();
+        made = VulkanObjectsMade[kind].load();
+    }
+
+    // Banjo-Tooie: the bytes every live buffer and texture holds, grouped by label, so the [vram] log can
+    // say what is filling video memory. A texture or buffer starts under a label made from its kind and
+    // size and moves to its name once RT64 names it; numbered names ("... #12") share one group.
+    struct VideoMemoryTally {
+        int64_t count = 0;
+        int64_t bytes = 0;
+    };
+    static std::mutex VideoMemoryTallyMutex;
+    static std::map<std::string, VideoMemoryTally> VideoMemoryTallies;
+
+    static void TallyVideoMemory(const std::string &label, int64_t bytes, int delta) {
+        if (label.empty()) {
+            return;
+        }
+
+        std::lock_guard<std::mutex> lock(VideoMemoryTallyMutex);
+        VideoMemoryTally &tally = VideoMemoryTallies[label];
+        tally.count += delta;
+        tally.bytes += bytes * delta;
+        if (tally.count <= 0) {
+            VideoMemoryTallies.erase(label);
+        }
+    }
+
+    static void RelabelVideoMemory(std::string &label, const std::string &newLabel, int64_t bytes) {
+        if (label.empty() || (label == newLabel)) {
+            return;
+        }
+
+        TallyVideoMemory(label, bytes, -1);
+        label = newLabel;
+        TallyVideoMemory(label, bytes, +1);
+    }
+
+    std::vector<VideoMemoryGroup> GetVideoMemoryGroups() {
+        std::vector<VideoMemoryGroup> groups;
+        std::lock_guard<std::mutex> lock(VideoMemoryTallyMutex);
+        for (const auto &it : VideoMemoryTallies) {
+            groups.push_back({ it.first, it.second.count, it.second.bytes });
+        }
+
+        return groups;
+    }
