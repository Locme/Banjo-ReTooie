+    static void TallyVideoMemory(const std::string &label, int64_t bytes, int delta) {
+        if (label.empty()) {
+            return;
+        }
+
+        std::lock_guard<std::mutex> lock(VideoMemoryTallyMutex);
+        VideoMemoryTally &tally = VideoMemoryTallies[label];
+        tally.count += delta;
+        tally.bytes += bytes * delta;
+        if (tally.count <= 0) {
