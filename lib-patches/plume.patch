+    static std::string DeviceLostText;
+
+    static void NoteDeviceLost(VulkanDevice *device, const char *call) {
+        if (DeviceLostFlag.exchange(true)) {
+            return;
+        }
+
+        std::string text = std::string(call) + " returned VK_ERROR_DEVICE_LOST: the GPU stopped answering and the driver was reset, or it crashed.\n";
+        if ((device != nullptr) && device->checkpointsSupported && (vkGetQueueCheckpointDataNV != nullptr)) {
+            // For each queue, the last mark the GPU reached at each pipeline stage. A mark that reached the
+            // top of the pipe but not the bottom was still running.
+            for (size_t f = 0; f < device->queueFamilies.size(); f++) {
+                for (size_t q = 0; q < device->queueFamilies[f].queues.size(); q++) {
+                    VkQueue queue = device->queueFamilies[f].queues[q].vk;
+                    uint32_t count = 0;
+                    vkGetQueueCheckpointDataNV(queue, &count, nullptr);
+                    if (count == 0) {
+                        continue;
+                    }
+
+                    std::vector<VkCheckpointDataNV> data(count, { VK_STRUCTURE_TYPE_CHECKPOINT_DATA_NV });
+                    vkGetQueueCheckpointDataNV(queue, &count, data.data());
+                    for (uint32_t i = 0; i < count; i++) {
+                        const char *stage = (data[i].stage == VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT) ? "started" :
+                            (data[i].stage == VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT) ? "finished" : "reached";
+                        const char *marker = (data[i].pCheckpointMarker != nullptr) ? static_cast<const char *>(data[i].pCheckpointMarker) : "(none)";
+                        char line[256];
+                        snprintf(line, sizeof(line), "    queue %zu.%zu: last pass %s: %s\n", f, q, stage, marker);
+                        text += line;
+                    }
+                }
+            }
+        }
+        else {
+            text += "    (this driver keeps no checkpoints, so the pass it was in is not known)\n";
+        }
+
+        fprintf(stderr, "[gpu] %s", text.c_str());
+        std::scoped_lock lock(DeviceLostMutex);
+        DeviceLostText = text;
+    }
+
+    // Logs a failed call: the first device lost gets the report, later ones are not printed.
+    static void LogFailedCall(VulkanDevice *device, const char *call, VkResult res) {
+        if (res == VK_ERROR_DEVICE_LOST) {
+            NoteDeviceLost(device, call);
+        }
+        else if (!DeviceLostFlag.load()) {
+            fprintf(stderr, "%s failed with error code 0x%X.\n", call, res);
+        }
+    }
+
+    bool DeviceLost() {
+        return DeviceLostFlag.load();
+    }
+
+    std::string DeviceLostReport() {
+        std::scoped_lock lock(DeviceLostMutex);
+        return DeviceLostText;
+    }
