+    static std::atomic<int64_t> VulkanObjectsLive[ObjCount];
+    static std::atomic<int64_t> VulkanObjectsMade[ObjCount];
+
+    static void CountObject(VulkanObjectKind kind, int delta) {
+        VulkanObjectsLive[kind] += delta;
+        if (delta > 0) {
+            VulkanObjectsMade[kind] += delta;
+        }
+    }
+
+    int GetVulkanObjectKinds() {
+        return ObjCount;
+    }
+
+    const char *GetVulkanObjectName(int kind) {
+        return VulkanObjectNames[kind];
+    }
+
+    void GetVulkanObjectCount(int kind, int64_t &live, int64_t &made) {
+        live = VulkanObjectsLive[kind].load();
+        made = VulkanObjectsMade[kind].load();
+    }
+
+    // Banjo-Tooie: video memory use for logs. The device that made the allocator last.
+    static std::atomic<VulkanDevice *> MemoryReportDevice = nullptr;
+
+    bool GetVideoMemoryUse(uint64_t &usage, uint64_t &budget) {
+        usage = 0;
+        budget = 0;
+        VulkanDevice *device = MemoryReportDevice.load();
+        if ((device == nullptr) || (device->allocator == VK_NULL_HANDLE)) {
+            return false;
+        }
+
+        const VkPhysicalDeviceMemoryProperties *properties = nullptr;
+        vmaGetMemoryProperties(device->allocator, &properties);
+        VmaBudget budgets[VK_MAX_MEMORY_HEAPS] = {};
+        vmaGetHeapBudgets(device->allocator, budgets);
+        for (uint32_t i = 0; i < properties->memoryHeapCount; i++) {
+            if (properties->memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) {
+                usage += budgets[i].usage;
+                budget += budgets[i].budget;
+            }
+        }
+
+        return true;
+    }
+
+    // Banjo-Tooie: what our own allocations add up to in the device-local heaps, so a log can
+    // tell a leak of ours (these grow with the use) from memory the driver holds by itself.
+    bool GetVideoMemoryDetail(uint64_t &allocationBytes, uint64_t &allocationCount, uint64_t &blockBytes) {
+        allocationBytes = 0;
+        allocationCount = 0;
+        blockBytes = 0;
+        VulkanDevice *device = MemoryReportDevice.load();
+        if ((device == nullptr) || (device->allocator == VK_NULL_HANDLE)) {
+            return false;
+        }
+
+        const VkPhysicalDeviceMemoryProperties *properties = nullptr;
+        vmaGetMemoryProperties(device->allocator, &properties);
+        VmaBudget budgets[VK_MAX_MEMORY_HEAPS] = {};
+        vmaGetHeapBudgets(device->allocator, budgets);
+        for (uint32_t i = 0; i < properties->memoryHeapCount; i++) {
+            if (properties->memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) {
+                allocationBytes += budgets[i].statistics.allocationBytes;
+                allocationCount += budgets[i].statistics.allocationCount;
+                blockBytes += budgets[i].statistics.blockBytes;
+            }
+        }
+
+        return true;
+    }
