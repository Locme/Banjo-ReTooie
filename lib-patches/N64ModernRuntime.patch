+void recomp::overlays::save_overlay_state(OverlayState& state) {
+    state.loaded_sections.clear();
+    for (const LoadedSection& s : loaded_sections) {
+        state.loaded_sections.emplace_back(s.loaded_ram_addr, s.section_table_index);
+    }
+    state.func_map = func_map;
+    state.section_addresses.assign(section_addresses, section_addresses + sections_info.total_num_sections);
+}
+
+void recomp::overlays::load_overlay_state(const OverlayState& state) {
+    loaded_sections.clear();
+    for (const auto& [ram, index] : state.loaded_sections) {
+        loaded_sections.emplace_back(ram, index);
+    }
+    func_map = state.func_map;
+    std::copy(state.section_addresses.begin(), state.section_addresses.end(), section_addresses);
+}
