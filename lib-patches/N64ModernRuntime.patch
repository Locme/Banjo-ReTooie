+
+void ultramodern::begin_game_idle() {
+    const std::lock_guard lock{ idle_mutex };
+    if (idle_waiters++ == 0) {
+        idle_since = std::chrono::steady_clock::now();
+    }
+}
+
+void ultramodern::end_game_idle() {
+    const std::lock_guard lock{ idle_mutex };
+    if (--idle_waiters == 0) {
