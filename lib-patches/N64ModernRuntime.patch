+// While the game holds the RDP frozen (DPC_STATUS_FREEZE), a real RDP does not
+// process commands, so a display list submitted in that time cannot finish
+// until the game clears the bit. The host renders it straight away, so hold
+// back its completion message until then. Games that pace frames with the
+// freeze bit (Banjo-Tooie) otherwise see the completion too early and lose
+// track of the frame.
+static bool dp_frozen = false;
+static int dp_completions_held = 0;
+
 void dp_complete() {
     uint8_t* rdram = events_context.rdram;
     std::lock_guard lock{ events_context.message_mutex };
+    if (dp_frozen) {
+        dp_completions_held++;
+        return;
+    }
     ultramodern::enqueue_external_message(events_context.dp.mq, events_context.dp.msg, false, true);
 }
 
+void ultramodern::set_dp_frozen(bool frozen) {
+    std::lock_guard lock{ events_context.message_mutex };
+    dp_frozen = frozen;
+    if (!frozen) {
+        for (; dp_completions_held > 0; dp_completions_held--) {
+            ultramodern::enqueue_external_message(events_context.dp.mq, events_context.dp.msg, false, true);
+        }
+    }
+}
+
