+uint64_t ultramodern::game_idle_ns() {
+    // A wait still going on counts up to now, so a long one isn't added all at once when it ends.
+    const std::lock_guard lock{ idle_mutex };
+    uint64_t total = idle_ns.load(std::memory_order_relaxed);
+    if (idle_waiters > 0) {
+        total += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - idle_since).count());
