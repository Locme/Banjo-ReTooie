+// The Freeze bit follows ultramodern's hold state, which a save state load puts back (set_dp_hold_state):
+// kept here as well, a load could leave the two disagreeing, and the game's next unfreeze was then
+// never passed on, so the held completions never arrived and the game hung (Freeze, T371).
+static void sync_freeze_bit() {
+    if (ultramodern::get_dp_hold_state().first) {
+        rdp_state |= 1U << (int)RDPStatusBit::Freeze;
+    }
+    else {
+        rdp_state &= ~(1U << (int)RDPStatusBit::Freeze);
+    }
+}
