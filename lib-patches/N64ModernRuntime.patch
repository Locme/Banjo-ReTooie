+// The Freeze bit follows ultramodern's hold state, which a save state load puts back (set_dp_hold_state):
+// kept here as well, a load could leave the two disagreeing, and the game's next unfreeze was then
+// never passed on, so the held completions never arrived and the game hung (Freeze, T371).
+static void sync_freeze_bit() {
+    if (ultramodern::get_dp_hold_state().first) {
+        rdp_state |= 1U << (int)RDPStatusBit::Freeze;
+    }
+    else {
+        rdp_state &= ~(1U << (int)RDPStatusBit::Freeze);
+    }
+}
+
 extern "C" void osDpGetStatus_recomp(uint8_t* rdram, recomp_context* ctx) {
+    sync_freeze_bit();
     ctx->r2 = rdp_state;
 }
 
 extern "C" void osDpSetStatus_recomp(uint8_t* rdram, recomp_context* ctx) {
     update_bit(rdp_state, ctx->r4, RDPStatusBit::XbusDmem);
+    sync_freeze_bit();
+    bool was_frozen = (rdp_state & (1U << (int)RDPStatusBit::Freeze)) != 0;
     update_bit(rdp_state, ctx->r4, RDPStatusBit::Freeze);
+    bool frozen = (rdp_state & (1U << (int)RDPStatusBit::Freeze)) != 0;
+    if (frozen != was_frozen) {
+        ultramodern::set_dp_frozen(frozen);
+    }
     update_bit(rdp_state, ctx->r4, RDPStatusBit::Flush);
 }
